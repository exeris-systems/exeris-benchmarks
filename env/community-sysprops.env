#!/usr/bin/env bash
# Provider FQCNs for the SPI-native bring-up of FD-owner ownership model benchmarks.
# Sourced by tools/bench/run-jmh-case.sh when sysprops_env_source=community.
#
# These point to the Community implementation of KernelCryptoProvider/MemoryProvider —
# but note: the BENCHMARK (FdOwnerTlsEngineLoopbackBenchmark / *RoundTrip) measures the
# CORE OffHeapTlsEngine wrapped under the FD-owner harness. The Community classes here
# are just one possible bringup of that CORE; any third party can plug in their own
# KernelCryptoProvider via the same SPI and reuse the same benchmark.

export EXERIS_COMMUNITY_CRYPTO_PROVIDER_CLASS="eu.exeris.kernel.community.crypto.CommunityKernelCryptoProvider"
export EXERIS_COMMUNITY_MEMORY_PROVIDER_CLASS="eu.exeris.kernel.community.memory.CommunityMemoryProvider"

# Prevent glibc malloc arena fragmentation in containerized/multi-threaded benchmarks.
# Reduces RSS fragmentation from multiple arenas. Must be identical in Community and
# Enterprise env files to ensure RSS comparability. See docs/methodology.md.
export MALLOC_ARENA_MAX=2
