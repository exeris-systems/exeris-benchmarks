<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>eu.exeris.benchmarks</groupId>
  <artifactId>exeris-benchmarks-fuzz</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>Exeris :: Benchmarks :: Jazzer Fuzz Campaigns</name>
  <description>
    Jazzer + JUnit 5 fuzz campaigns against kernel HTTP/1 and HTTP/2 parsers.
    Standalone module — NOT a parent of micro/jmh. Imports kernel snapshots
    from GitHub Packages, same as micro/jmh.
    Run with: mvn -s ../../.github/maven-settings-gpr.xml test
  </description>

  <properties>
    <java.version>26</java.version>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <jazzer.version>0.22.1</jazzer.version>
    <junit.jupiter.version>5.10.2</junit.jupiter.version>
    <surefire.version>3.2.5</surefire.version>

    <!-- Exeris artifact version. Fuzz findings are only re-bisectable if the
         kernel version is pinned; an unpinned floating snapshot (or worse,
         a stale literal like 0.5.0) silently invalidates reproducibility.
         The maven-enforcer rule below rejects the sentinel default. Always
         pass -Dexeris.kernel.version=<release|timestamped-snapshot>. -->
    <exeris.kernel.version>UNSPECIFIED-PIN-VIA-Dexeris.kernel.version</exeris.kernel.version>

    <!-- Per-FuzzTest wall-clock budget. Override on CLI:
         mvn test -Djazzer.duration=300s -->
    <jazzer.duration>60s</jazzer.duration>
  </properties>

  <repositories>
    <repository>
      <id>github-exeris-kernel</id>
      <url>https://maven.pkg.github.com/exeris-systems/exeris-kernel</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>

  <!--
    The JUnit BOM is load-bearing, not hygiene. jazzer-junit 0.22.1 drags in
    junit-platform-commons and junit-platform-launcher 1.9.0, while junit-jupiter-engine 5.10.2
    needs platform 1.10.2. Maven's nearest-wins picks Jazzer's 1.9.0 because jazzer-junit is
    declared first at the same depth, and the engine then calls a method that does not exist in
    the older commons:

      NoSuchMethodError: ReflectionSupport.streamNestedClasses(Class, Predicate)

    which surfaces as "TestEngine with ID 'junit-jupiter' failed to discover tests" — zero tests
    run, and before the runner was hardened on 2026-08-26 that was reported as "stable".
    Importing the BOM pins every junit-platform artifact to the line that matches the engine.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.jupiter.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.code-intelligence</groupId>
      <artifactId>jazzer-junit</artifactId>
      <version>${jazzer.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>${junit.jupiter.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>${junit.jupiter.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>eu.exeris</groupId>
      <artifactId>exeris-kernel-spi</artifactId>
      <version>${exeris.kernel.version}</version>
    </dependency>
    <dependency>
      <groupId>eu.exeris</groupId>
      <artifactId>exeris-kernel-core</artifactId>
      <version>${exeris.kernel.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <id>require-pinned-kernel-version</id>
            <phase>validate</phase>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireProperty>
                  <property>exeris.kernel.version</property>
                  <regex>^(?!UNSPECIFIED-).+</regex>
                  <regexMessage>
exeris.kernel.version must be pinned. Pass it explicitly:
  mvn -Dexeris.kernel.version=&lt;release&gt; ...
  mvn -Dexeris.kernel.version=&lt;1.2.3-YYYYMMDD.HHMMSS-N&gt; ...
A floating -SNAPSHOT is non-reproducible; a stale literal silently invalidates findings.
                  </regexMessage>
                </requireProperty>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
          <compilerVersion>${java.version}</compilerVersion>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <argLine>--enable-preview --enable-native-access=ALL-UNNAMED</argLine>
          <systemPropertyVariables>
            <!--
              jazzer.duration is NOT a property Jazzer reads. It is kept only so the value is
              visible in the forked JVM's properties for debugging; nothing consumes it.
              Campaign length is controlled solely by @FuzzTest(maxDuration = "...") on each test.

              Two things were tried on 2026-08-26 and both failed, so do not repeat them:
                - -Djazzer.* on the mvn command line never reaches the FORKED test JVM (only
                  systemPropertyVariables do), so it cannot work from outside at all;
                - routing -max_total_time through jazzer.internal.arg.0 from here DOES reach the
                  fork, but Jazzer appends the annotation's own -max_total_time afterwards and
                  libFuzzer takes the last occurrence. Measured: a 20s request still ran 66s.

              To change campaign length, edit the annotation. scripts/run-fuzz-campaign.sh reads
              it back so the artifact records the duration that actually applied.
            -->
            <jazzer.duration>${jazzer.duration}</jazzer.duration>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
