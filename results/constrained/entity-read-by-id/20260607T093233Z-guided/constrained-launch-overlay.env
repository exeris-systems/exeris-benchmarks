export JAVA_TOOL_OPTIONS=-XX:+UseSerialGC\ -XX:ActiveProcessorCount=1\ -XX:MaxRAM=256m\ -Xms64m\ -Xmx192m
export BENCHMARK_EXECUTION_PROFILE_ID=runtime-constrained-256m-1vcpu-v1
export BENCHMARK_TRACK_ID=track-c
export EXERIS_DB_POOL_MIN_SIZE=2
export EXERIS_DB_POOL_MAX_SIZE=16
export EXERIS_DB_CONNECTION_TIMEOUT_MS=5000
