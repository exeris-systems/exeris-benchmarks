export JAVA_TOOL_OPTIONS=-XX:+UseParallelGC\ -XX:ActiveProcessorCount=4\ -XX:MaxRAM=1024m\ -Xms256m\ -Xmx256m
export BENCHMARK_EXECUTION_PROFILE_ID=runtime-constrained-1024m-4vcpu-v1
export BENCHMARK_TRACK_ID=track-c
export EXERIS_DB_POOL_MIN_SIZE=16
export EXERIS_DB_POOL_MAX_SIZE=16
export EXERIS_DB_CONNECTION_TIMEOUT_MS=5000
