# Example environment for using canonical Community benchmark launcher via external mode.
#
# Copy to runtime/drivers/env/community-runtime.env when needed.

START_MODE=external

# Uses canonical launcher from runtime/drivers/
EXTERNAL_START_CMD=bash runtime/drivers/community-stack-launcher.sh --mode http --port 18080
EXTERNAL_STOP_CMD=pkill -f 'eu.exeris.kernel.launcher.CommunityStackLauncher' || true

HEALTH_URL=http://127.0.0.1:18080/health
HEALTH_TIMEOUT_SECONDS=60

TARGET_TIER=community
TARGET_PROTOCOL=h1
COMPARISON_AXIS=within-tier
