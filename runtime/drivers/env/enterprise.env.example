# Example env for Enterprise target execution
# Copy to runtime/drivers/env/enterprise.env and adjust.

START_MODE=external
EXTERNAL_START_CMD=/opt/exeris-enterprise-bench/run-start.sh
EXTERNAL_STOP_CMD=/opt/exeris-enterprise-bench/run-stop.sh

HEALTH_URL=https://localhost:8443/health
HEALTH_TIMEOUT_SECONDS=90

# Default runtime profile (can be overridden by scripts)
TARGET_TIER=enterprise
TARGET_PROTOCOL=h2
COMPARISON_AXIS=within-tier
