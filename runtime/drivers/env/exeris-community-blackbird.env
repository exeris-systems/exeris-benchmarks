# Runtime target env for exeris-blackbird — the SAME exeris-community-app jar (kernel 0.10.1),
# but launched with the ADR-052 Blackbird JsonMapperCustomizer uber-jar ADDED to the classpath.
# Its ServiceLoader presence makes CommunityJsonMappers.forScope() add the Jackson-3 Blackbird module
# (invokedynamic property accessors) → the "faster serialization path" arm of the CPU/req experiment.
#
# Pairing: exeris-community (default, :9000, pristine `-jar app.jar`) vs exeris-blackbird (:9005,
# `-cp app.jar:customizer.jar` + main class). BOTH run the SAME 0.10.1 app jar + same EXERIS_JAVA_OPTS
# (heap + telemetry-off/steady-state JFR overlay), so the ONLY measured difference is Blackbird.
#
# Launch uses -cp (not -jar) so the customizer uber-jar joins the classpath; jackson-databind/core and
# the community seam resolve from the app's shaded jar (both jackson 3.1.1 — no version clash).

START_MODE=external
HEALTH_URL=http://localhost:9005/health
HEALTH_TIMEOUT_SECONDS=60

EXERIS_DB_JDBC_URL=${EXERIS_DB_JDBC_URL:-jdbc:postgresql://localhost:5432/postgres?prepareThreshold=1}
EXERIS_DB_USERNAME=${EXERIS_DB_USERNAME:-postgres}
EXERIS_DB_PASSWORD=${EXERIS_DB_PASSWORD:-postgres}
EXERIS_DB_POOL_MIN_SIZE=${EXERIS_DB_POOL_MIN_SIZE:-16}
EXERIS_DB_POOL_MAX_SIZE=${EXERIS_DB_POOL_MAX_SIZE:-256}
EXERIS_BLACKBIRD_PORT=${EXERIS_BLACKBIRD_PORT:-9005}
SERVER_CPU_AFFINITY=${SERVER_CPU_AFFINITY:-}
EXERIS_JAVA_OPTS="--add-opens java.base/sun.nio.ch=ALL-UNNAMED --add-opens java.base/java.io=ALL-UNNAMED --enable-native-access=ALL-UNNAMED${EXERIS_JAVA_OPTS:+ ${EXERIS_JAVA_OPTS}}"
EXERIS_ENABLE_TELEMETRY_SUBSYSTEM=${EXERIS_ENABLE_TELEMETRY_SUBSYSTEM:-false}
EXERIS_TELEMETRY_JFR_ENABLED=${EXERIS_TELEMETRY_JFR_ENABLED:-${EXERIS_ENABLE_TELEMETRY_SUBSYSTEM:-false}}
EXERIS_JFR_VTHREAD_PINNED=${EXERIS_JFR_VTHREAD_PINNED:-false}
EXERIS_TRANSPORT_CERT_PATH=${EXERIS_TRANSPORT_CERT_PATH:-}
EXERIS_TRANSPORT_KEY_PATH=${EXERIS_TRANSPORT_KEY_PATH:-}
APP_JAR=${APP_JAR:-targets/exeris-community-app/target/exeris-community-app-1.0.0-SNAPSHOT.jar}
BLACKBIRD_JAR=${BLACKBIRD_JAR:-targets/exeris-community-blackbird-customizer/target/exeris-community-blackbird-customizer-1.0.0-SNAPSHOT.jar}
EXTERNAL_PID_FILE=${EXTERNAL_PID_FILE:-/tmp/exeris-${USER:-unknown}-blackbird.pid}

EXTERNAL_START_CMD='EXERIS_PORT="$EXERIS_BLACKBIRD_PORT" EXERIS_HTTP_MAX_VERSION="${EXERIS_HTTP_MAX_VERSION:-HTTP_1_1}" EXERIS_HTTP_H2C_UPGRADE_ENABLED="${EXERIS_HTTP_H2C_UPGRADE_ENABLED:-false}" EXERIS_TRANSPORT_CERT_PATH="${EXERIS_TRANSPORT_CERT_PATH:-}" EXERIS_TRANSPORT_KEY_PATH="${EXERIS_TRANSPORT_KEY_PATH:-}" EXERIS_DB_JDBC_URL="$EXERIS_DB_JDBC_URL" EXERIS_DB_USERNAME="$EXERIS_DB_USERNAME" EXERIS_DB_PASSWORD="$EXERIS_DB_PASSWORD" EXERIS_DB_POOL_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" EXERIS_DB_POOL_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" EXERIS_ENABLE_TELEMETRY_SUBSYSTEM="$EXERIS_ENABLE_TELEMETRY_SUBSYSTEM" EXERIS_TELEMETRY_JFR_ENABLED="$EXERIS_TELEMETRY_JFR_ENABLED" EXERIS_JFR_VTHREAD_PINNED="$EXERIS_JFR_VTHREAD_PINNED" ${SERVER_CPU_AFFINITY:+taskset -c ${SERVER_CPU_AFFINITY} }java $EXERIS_JAVA_OPTS --enable-preview -cp "$APP_JAR:$BLACKBIRD_JAR" eu.exeris.benchmarks.targets.exeriscommunity.bootstrap.ExerisCommunityApplication > /tmp/exeris-blackbird-9005.log 2>&1 & echo $! > "$EXTERNAL_PID_FILE"'
EXTERNAL_STOP_CMD='if [[ -f "$EXTERNAL_PID_FILE" ]]; then pid="$(cat "$EXTERNAL_PID_FILE")"; kill "$pid" >/dev/null 2>&1 || true; rm -f "$EXTERNAL_PID_FILE"; fi'

TARGET_TIER=community
TARGET_PROTOCOL=h1
COMPARISON_AXIS=within-tier
