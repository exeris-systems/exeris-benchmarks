# Runtime target env for the canonical exeris-community target (native kernel).
# Concrete launcher contract used by comparative + e2e/saga scripts.
#
# Protocol-parametrized: defaults to H1 cleartext on :9000 (the within-tier H1
# fair baseline used by entity-read-by-id). Protocol/TLS are an OVERRIDE axis —
# the run-guided protocol+TLS toggle and the saga runner (configure_target_runtime_overrides)
# export EXERIS_PORT / EXERIS_HTTP_MAX_VERSION / EXERIS_HTTP_H2C_UPGRADE_ENABLED /
# EXERIS_TRANSPORT_CERT_PATH/KEY_PATH, which this launch contract now honors. This
# replaces the former exeris-benchmark-app-community-h1 (h1/:9000) and
# exeris-e2e-community-h2 (h2c·h2-TLS/:8080) split into one protocol-flexible target.

START_MODE=external
HEALTH_URL=http://localhost:9000/health
HEALTH_TIMEOUT_SECONDS=60

EXERIS_DB_JDBC_URL=${EXERIS_DB_JDBC_URL:-jdbc:postgresql://localhost:5432/postgres?prepareThreshold=1}
EXERIS_DB_USERNAME=${EXERIS_DB_USERNAME:-postgres}
EXERIS_DB_PASSWORD=${EXERIS_DB_PASSWORD:-postgres}
EXERIS_DB_POOL_MIN_SIZE=${EXERIS_DB_POOL_MIN_SIZE:-16}
EXERIS_DB_POOL_MAX_SIZE=${EXERIS_DB_POOL_MAX_SIZE:-256}
SERVER_CPU_AFFINITY=${SERVER_CPU_AFFINITY:-}
EXERIS_JAVA_OPTS="--add-opens java.base/sun.nio.ch=ALL-UNNAMED --add-opens java.base/java.io=ALL-UNNAMED --enable-native-access=ALL-UNNAMED${EXERIS_JAVA_OPTS:+ ${EXERIS_JAVA_OPTS}}"
EXERIS_ENABLE_TELEMETRY_SUBSYSTEM=${EXERIS_ENABLE_TELEMETRY_SUBSYSTEM:-false}
EXERIS_TELEMETRY_JFR_ENABLED=${EXERIS_TELEMETRY_JFR_ENABLED:-${EXERIS_ENABLE_TELEMETRY_SUBSYSTEM:-false}}
EXERIS_JFR_VTHREAD_PINNED=${EXERIS_JFR_VTHREAD_PINNED:-false}
EXERIS_TRANSPORT_CERT_PATH=${EXERIS_TRANSPORT_CERT_PATH:-}
EXERIS_TRANSPORT_KEY_PATH=${EXERIS_TRANSPORT_KEY_PATH:-}
EXTERNAL_PID_FILE=${EXTERNAL_PID_FILE:-/tmp/exeris-${USER:-unknown}-community-runtime.pid}

EXTERNAL_START_CMD='EXERIS_PORT=${EXERIS_PORT:-9000} EXERIS_HTTP_MAX_VERSION="${EXERIS_HTTP_MAX_VERSION:-HTTP_1_1}" EXERIS_HTTP_H2C_UPGRADE_ENABLED="${EXERIS_HTTP_H2C_UPGRADE_ENABLED:-false}" EXERIS_TRANSPORT_CERT_PATH="${EXERIS_TRANSPORT_CERT_PATH:-}" EXERIS_TRANSPORT_KEY_PATH="${EXERIS_TRANSPORT_KEY_PATH:-}" EXERIS_DB_JDBC_URL="$EXERIS_DB_JDBC_URL" EXERIS_DB_USERNAME="$EXERIS_DB_USERNAME" EXERIS_DB_PASSWORD="$EXERIS_DB_PASSWORD" EXERIS_DB_POOL_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" EXERIS_DB_POOL_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" EXERIS_ENABLE_TELEMETRY_SUBSYSTEM="$EXERIS_ENABLE_TELEMETRY_SUBSYSTEM" EXERIS_TELEMETRY_JFR_ENABLED="$EXERIS_TELEMETRY_JFR_ENABLED" EXERIS_JFR_VTHREAD_PINNED="$EXERIS_JFR_VTHREAD_PINNED" ${TARGET_MEM_SCOPE_PREFIX:-}${SERVER_CPU_AFFINITY:+taskset -c ${SERVER_CPU_AFFINITY} }java $EXERIS_JAVA_OPTS --enable-preview -jar targets/exeris-community-app/target/exeris-community-app-1.0.0-SNAPSHOT.jar > /tmp/exeris-community.log 2>&1 & echo $! > "$EXTERNAL_PID_FILE"'
EXTERNAL_STOP_CMD='if [[ -f "$EXTERNAL_PID_FILE" ]]; then pid="$(cat "$EXTERNAL_PID_FILE")"; kill "$pid" >/dev/null 2>&1 || true; rm -f "$EXTERNAL_PID_FILE"; fi'

TARGET_TIER=community
TARGET_PROTOCOL=h1
COMPARISON_AXIS=within-tier
