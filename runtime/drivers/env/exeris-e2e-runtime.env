# Runtime target env for exeris-e2e-community-h2.
# Concrete launcher contract used by e2e baseline scripts.

START_MODE=external
HEALTH_TIMEOUT_SECONDS=60

EXERIS_DB_JDBC_URL=jdbc:postgresql://localhost:5432/postgres?prepareThreshold=1
EXERIS_DB_USERNAME=postgres
EXERIS_DB_PASSWORD=postgres
EXERIS_DB_POOL_MIN_SIZE=${EXERIS_DB_POOL_MIN_SIZE:-16}
EXERIS_DB_POOL_MAX_SIZE=${EXERIS_DB_POOL_MAX_SIZE:-256}
SERVER_CPU_AFFINITY=${SERVER_CPU_AFFINITY:-}
EXERIS_JAVA_OPTS="--add-opens java.base/java.io=ALL-UNNAMED --add-opens java.base/sun.nio.ch=ALL-UNNAMED --enable-native-access=ALL-UNNAMED${EXERIS_JAVA_OPTS:+ $EXERIS_JAVA_OPTS}"
EXERIS_ENABLE_TELEMETRY_SUBSYSTEM=${EXERIS_ENABLE_TELEMETRY_SUBSYSTEM:-false}
EXERIS_TELEMETRY_JFR_ENABLED=${EXERIS_TELEMETRY_JFR_ENABLED:-${EXERIS_ENABLE_TELEMETRY_SUBSYSTEM:-false}}
EXERIS_JFR_VTHREAD_PINNED=${EXERIS_JFR_VTHREAD_PINNED:-false}
EXERIS_TRANSPORT_CERT_PATH=${EXERIS_TRANSPORT_CERT_PATH:-}
EXERIS_TRANSPORT_KEY_PATH=${EXERIS_TRANSPORT_KEY_PATH:-}
EXTERNAL_PID_FILE=${EXTERNAL_PID_FILE:-/tmp/exeris-${USER:-unknown}-e2e-community-8080.pid}

EXTERNAL_START_CMD='if [[ -n "$SERVER_CPU_AFFINITY" ]]; then EXERIS_PORT=${EXERIS_PORT:-8080} EXERIS_HTTP_MAX_VERSION="${EXERIS_HTTP_MAX_VERSION:-HTTP_2}" EXERIS_HTTP_H2C_UPGRADE_ENABLED="${EXERIS_HTTP_H2C_UPGRADE_ENABLED:-true}" EXERIS_DB_JDBC_URL="$EXERIS_DB_JDBC_URL" EXERIS_DB_USERNAME="$EXERIS_DB_USERNAME" EXERIS_DB_PASSWORD="$EXERIS_DB_PASSWORD" EXERIS_DB_POOL_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" EXERIS_DB_POOL_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" EXERIS_ENABLE_TELEMETRY_SUBSYSTEM="$EXERIS_ENABLE_TELEMETRY_SUBSYSTEM" EXERIS_TELEMETRY_JFR_ENABLED="$EXERIS_TELEMETRY_JFR_ENABLED" EXERIS_JFR_VTHREAD_PINNED="$EXERIS_JFR_VTHREAD_PINNED" EXERIS_TRANSPORT_CERT_PATH="$EXERIS_TRANSPORT_CERT_PATH" EXERIS_TRANSPORT_KEY_PATH="$EXERIS_TRANSPORT_KEY_PATH" taskset -c "$SERVER_CPU_AFFINITY" java $EXERIS_JAVA_OPTS --enable-preview -jar targets/exeris-community-app/target/exeris-community-app-1.0.0-SNAPSHOT.jar > /tmp/exeris-community-8080.log 2>&1 & else EXERIS_PORT=${EXERIS_PORT:-8080} EXERIS_HTTP_MAX_VERSION="${EXERIS_HTTP_MAX_VERSION:-HTTP_2}" EXERIS_HTTP_H2C_UPGRADE_ENABLED="${EXERIS_HTTP_H2C_UPGRADE_ENABLED:-true}" EXERIS_DB_JDBC_URL="$EXERIS_DB_JDBC_URL" EXERIS_DB_USERNAME="$EXERIS_DB_USERNAME" EXERIS_DB_PASSWORD="$EXERIS_DB_PASSWORD" EXERIS_DB_POOL_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" EXERIS_DB_POOL_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" EXERIS_ENABLE_TELEMETRY_SUBSYSTEM="$EXERIS_ENABLE_TELEMETRY_SUBSYSTEM" EXERIS_TELEMETRY_JFR_ENABLED="$EXERIS_TELEMETRY_JFR_ENABLED" EXERIS_JFR_VTHREAD_PINNED="$EXERIS_JFR_VTHREAD_PINNED" EXERIS_TRANSPORT_CERT_PATH="$EXERIS_TRANSPORT_CERT_PATH" EXERIS_TRANSPORT_KEY_PATH="$EXERIS_TRANSPORT_KEY_PATH" java $EXERIS_JAVA_OPTS --enable-preview -jar targets/exeris-community-app/target/exeris-community-app-1.0.0-SNAPSHOT.jar > /tmp/exeris-community-8080.log 2>&1 & fi; echo $! > "$EXTERNAL_PID_FILE"'
EXTERNAL_STOP_CMD='if [[ -f "$EXTERNAL_PID_FILE" ]]; then pid="$(cat "$EXTERNAL_PID_FILE")"; kill "$pid" >/dev/null 2>&1 || true; rm -f "$EXTERNAL_PID_FILE"; fi'

TARGET_TIER=community
TARGET_PROTOCOL=h2c
COMPARISON_AXIS=within-tier