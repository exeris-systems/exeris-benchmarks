# Serialisation-matrix ARM 2 — exeris-community app on kernel 0.10.1 WITH the Blackbird customizer.
# Accessor path = Jackson-3 Blackbird invokedynamic (monomorphic, inlinable).
# Encode path   = materialise-to-heap-byte[]-then-copy (pre-SegmentSink), same as arm 1.
#
# Launched with -cp (not -jar) so the ADR-052 customizer uber-jar joins the classpath; its
# ServiceLoader presence is the ONLY difference from arm 1 — same staged jar, same JVM opts.
# The customizer prints "[exeris-blackbird] applied Jackson-3 BlackbirdModule to JSON scope ..."
# once per scope at bootstrap; that breadcrumb is the launch assertion proving this arm is not a
# silent no-op. A leaf without it must fail rather than be interpreted.
#
# One customizer jar serves both kernel versions: the seam was verified identical between v0.10.1
# and v0.10.2 (zero commits touching */community/json/*), and it is a provided-scope dependency.

START_MODE=external
HEALTH_URL=http://localhost:9011/health
HEALTH_TIMEOUT_SECONDS=60

EXERIS_DB_JDBC_URL=${EXERIS_DB_JDBC_URL:-jdbc:postgresql://localhost:5432/postgres?prepareThreshold=1}
EXERIS_DB_USERNAME=${EXERIS_DB_USERNAME:-postgres}
EXERIS_DB_PASSWORD=${EXERIS_DB_PASSWORD:-postgres}
EXERIS_DB_POOL_MIN_SIZE=${EXERIS_DB_POOL_MIN_SIZE:-16}
EXERIS_DB_POOL_MAX_SIZE=${EXERIS_DB_POOL_MAX_SIZE:-256}
EXERIS_K0101_BB_PORT=${EXERIS_K0101_BB_PORT:-9011}
SERVER_CPU_AFFINITY=${SERVER_CPU_AFFINITY:-}
EXERIS_JAVA_OPTS="--add-opens java.base/sun.nio.ch=ALL-UNNAMED --add-opens java.base/java.io=ALL-UNNAMED --enable-native-access=ALL-UNNAMED${EXERIS_JAVA_OPTS:+ ${EXERIS_JAVA_OPTS}}"
EXERIS_ENABLE_TELEMETRY_SUBSYSTEM=${EXERIS_ENABLE_TELEMETRY_SUBSYSTEM:-false}
EXERIS_TELEMETRY_JFR_ENABLED=${EXERIS_TELEMETRY_JFR_ENABLED:-${EXERIS_ENABLE_TELEMETRY_SUBSYSTEM:-false}}
EXERIS_JFR_VTHREAD_PINNED=${EXERIS_JFR_VTHREAD_PINNED:-false}
EXERIS_TRANSPORT_CERT_PATH=${EXERIS_TRANSPORT_CERT_PATH:-}
EXERIS_TRANSPORT_KEY_PATH=${EXERIS_TRANSPORT_KEY_PATH:-}
APP_JAR=${APP_JAR:-targets/_staging/exeris-community-app-k0.10.1.jar}
BLACKBIRD_JAR=${BLACKBIRD_JAR:-targets/exeris-community-blackbird-customizer/target/exeris-community-blackbird-customizer-1.0.0-SNAPSHOT.jar}
EXTERNAL_PID_FILE=${EXTERNAL_PID_FILE:-/tmp/exeris-${USER:-unknown}-k0101-bb.pid}

EXTERNAL_START_CMD='EXERIS_PORT="$EXERIS_K0101_BB_PORT" EXERIS_HTTP_MAX_VERSION="${EXERIS_HTTP_MAX_VERSION:-HTTP_1_1}" EXERIS_HTTP_H2C_UPGRADE_ENABLED="${EXERIS_HTTP_H2C_UPGRADE_ENABLED:-false}" EXERIS_TRANSPORT_CERT_PATH="${EXERIS_TRANSPORT_CERT_PATH:-}" EXERIS_TRANSPORT_KEY_PATH="${EXERIS_TRANSPORT_KEY_PATH:-}" EXERIS_DB_JDBC_URL="$EXERIS_DB_JDBC_URL" EXERIS_DB_USERNAME="$EXERIS_DB_USERNAME" EXERIS_DB_PASSWORD="$EXERIS_DB_PASSWORD" EXERIS_DB_POOL_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" EXERIS_DB_POOL_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" EXERIS_ENABLE_TELEMETRY_SUBSYSTEM="$EXERIS_ENABLE_TELEMETRY_SUBSYSTEM" EXERIS_TELEMETRY_JFR_ENABLED="$EXERIS_TELEMETRY_JFR_ENABLED" EXERIS_JFR_VTHREAD_PINNED="$EXERIS_JFR_VTHREAD_PINNED" ${SERVER_CPU_AFFINITY:+taskset -c ${SERVER_CPU_AFFINITY} }java $EXERIS_JAVA_OPTS --enable-preview -cp "$APP_JAR:$BLACKBIRD_JAR" eu.exeris.benchmarks.targets.exeriscommunity.bootstrap.ExerisCommunityApplication > /tmp/exeris-k0101-bb-9011.log 2>&1 & echo $! > "$EXTERNAL_PID_FILE"'
EXTERNAL_STOP_CMD='if [[ -f "$EXTERNAL_PID_FILE" ]]; then pid="$(cat "$EXTERNAL_PID_FILE")"; kill "$pid" >/dev/null 2>&1 || true; rm -f "$EXTERNAL_PID_FILE"; fi'

TARGET_TIER=community
TARGET_PROTOCOL=h1
COMPARISON_AXIS=within-tier
