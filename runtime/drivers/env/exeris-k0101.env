# Serialisation-matrix ARM 1 — exeris-community app on kernel 0.10.1, NO Blackbird customizer.
# Accessor path = Jackson-3 default MethodHandle (Invokers$Holder.invokeExact_MT).
# Encode path   = materialise-to-heap-byte[]-then-copy (pre-SegmentSink).
#
# The 2x2 matrix is (kernel version) x (Blackbird accessor):
#   arm1 exeris-k0101    :9010   0.10.1  MethodHandle   <- this file
#   arm2 exeris-k0101-bb :9011   0.10.1  Blackbird
#   arm3 exeris-k0102    :9012   0.10.2  MethodHandle
#   arm4 exeris-k0102-bb :9013   0.10.2  Blackbird
# (1v2) and (3v4) give the accessor effect at both encode levels; (1v3) and (2v4) give the
# encode effect at both accessor levels; the interaction is computable BOTH ways and must agree.
#
# APP_JAR points at the VERSION-STAGED artifact produced by build_target_artifact with
# -Dexeris.kernel.version=0.10.1. Without staging, the 0.10.2 build would overwrite the 0.10.1 jar
# at the shared module path and every arm would launch the same runtime.
#
# Port range 9010-9013 is deliberately clear of the existing targets (9000-9005) so any two arms
# can co-reside in one pair.

START_MODE=external
HEALTH_URL=http://localhost:9010/health
HEALTH_TIMEOUT_SECONDS=60

EXERIS_DB_JDBC_URL=${EXERIS_DB_JDBC_URL:-jdbc:postgresql://localhost:5432/postgres?prepareThreshold=1}
EXERIS_DB_USERNAME=${EXERIS_DB_USERNAME:-postgres}
EXERIS_DB_PASSWORD=${EXERIS_DB_PASSWORD:-postgres}
EXERIS_DB_POOL_MIN_SIZE=${EXERIS_DB_POOL_MIN_SIZE:-16}
EXERIS_DB_POOL_MAX_SIZE=${EXERIS_DB_POOL_MAX_SIZE:-256}
EXERIS_K0101_PORT=${EXERIS_K0101_PORT:-9010}
SERVER_CPU_AFFINITY=${SERVER_CPU_AFFINITY:-}
EXERIS_JAVA_OPTS="--add-opens java.base/sun.nio.ch=ALL-UNNAMED --add-opens java.base/java.io=ALL-UNNAMED --enable-native-access=ALL-UNNAMED${EXERIS_JAVA_OPTS:+ ${EXERIS_JAVA_OPTS}}"
EXERIS_ENABLE_TELEMETRY_SUBSYSTEM=${EXERIS_ENABLE_TELEMETRY_SUBSYSTEM:-false}
EXERIS_TELEMETRY_JFR_ENABLED=${EXERIS_TELEMETRY_JFR_ENABLED:-${EXERIS_ENABLE_TELEMETRY_SUBSYSTEM:-false}}
EXERIS_JFR_VTHREAD_PINNED=${EXERIS_JFR_VTHREAD_PINNED:-false}
EXERIS_TRANSPORT_CERT_PATH=${EXERIS_TRANSPORT_CERT_PATH:-}
EXERIS_TRANSPORT_KEY_PATH=${EXERIS_TRANSPORT_KEY_PATH:-}
# Path is written literally, not via a variable: the harness pre-flight extracts the `-jar`
# argument from EXTERNAL_START_CMD and stats it WITHOUT expanding shell variables, so a
# "$APP_JAR" here makes it look for a file named literally '$APP_JAR' and the target is
# rejected as misconfigured. Each arm pins one kernel version, so its staged path is constant
# anyway — the variable was never needed.
EXTERNAL_PID_FILE=${EXTERNAL_PID_FILE:-/tmp/exeris-${USER:-unknown}-k0101.pid}

EXTERNAL_START_CMD='EXERIS_PORT="$EXERIS_K0101_PORT" EXERIS_HTTP_MAX_VERSION="${EXERIS_HTTP_MAX_VERSION:-HTTP_1_1}" EXERIS_HTTP_H2C_UPGRADE_ENABLED="${EXERIS_HTTP_H2C_UPGRADE_ENABLED:-false}" EXERIS_TRANSPORT_CERT_PATH="${EXERIS_TRANSPORT_CERT_PATH:-}" EXERIS_TRANSPORT_KEY_PATH="${EXERIS_TRANSPORT_KEY_PATH:-}" EXERIS_DB_JDBC_URL="$EXERIS_DB_JDBC_URL" EXERIS_DB_USERNAME="$EXERIS_DB_USERNAME" EXERIS_DB_PASSWORD="$EXERIS_DB_PASSWORD" EXERIS_DB_POOL_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" EXERIS_DB_POOL_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" EXERIS_ENABLE_TELEMETRY_SUBSYSTEM="$EXERIS_ENABLE_TELEMETRY_SUBSYSTEM" EXERIS_TELEMETRY_JFR_ENABLED="$EXERIS_TELEMETRY_JFR_ENABLED" EXERIS_JFR_VTHREAD_PINNED="$EXERIS_JFR_VTHREAD_PINNED" ${SERVER_CPU_AFFINITY:+taskset -c ${SERVER_CPU_AFFINITY} }java $EXERIS_JAVA_OPTS --enable-preview -jar targets/_staging/exeris-community-app-k0.10.1.jar > /tmp/exeris-k0101-9010.log 2>&1 & echo $! > "$EXTERNAL_PID_FILE"'
EXTERNAL_STOP_CMD='if [[ -f "$EXTERNAL_PID_FILE" ]]; then pid="$(cat "$EXTERNAL_PID_FILE")"; kill "$pid" >/dev/null 2>&1 || true; rm -f "$EXTERNAL_PID_FILE"; fi'

TARGET_TIER=community
TARGET_PROTOCOL=h1
COMPARISON_AXIS=within-tier
