# GENERATED by scripts/generate-kernel-version-axis-wiring.sh from
# runtime/drivers/kernel-version-axis-arms.json - do not edit by hand.
#
# Kernel-version axis, arm D-double-prime: eu.exeris:0.11.0 on JDK 28
# (app compiled at release 28, preview flag true).
#
# ROLE: the recompile tax: same kernel as D-prime, but the app rebuilt at release 28 with preview. 30 of its 40 class files come out preview-marked from unchanged source (JEP 401 changes how the class-file format is read), so this cost belongs to the recompile, not to the preview kernel
#
# This arm is defined by the triple (staged jar, JDK, preview flag). Change any one of them here
# and the arm stops being the thing the axis claims to measure. Four arms share the staged jar
# exeris-community-app-k0.11.0-r28p.jar
# and differ only by JDK and flag, so the jar path alone does not identify a run - which is why
# scripts/verify-kernel-version-axis-boot.sh re-derives all three from /proc at launch.

START_MODE=external
HEALTH_URL=http://localhost:9026/health
HEALTH_TIMEOUT_SECONDS=60

# JDK homes are variables so the perf box can point at its own installs. The default is the
# developer-box layout. JDK28_HOME must be a JDK 28 or this arm is mislabelled.
JDK28_HOME=${JDK28_HOME:-/home/arkstack/Pobrane/openjdk-28-ea+10_linux-x64_bin/jdk-28}
ARM_JAVA_HOME=${JDK28_HOME}

EXERIS_DB_JDBC_URL=${EXERIS_DB_JDBC_URL:-jdbc:postgresql://localhost:5432/postgres?prepareThreshold=1}
EXERIS_DB_USERNAME=${EXERIS_DB_USERNAME:-postgres}
EXERIS_DB_PASSWORD=${EXERIS_DB_PASSWORD:-postgres}
EXERIS_DB_POOL_MIN_SIZE=${EXERIS_DB_POOL_MIN_SIZE:-16}
EXERIS_DB_POOL_MAX_SIZE=${EXERIS_DB_POOL_MAX_SIZE:-256}
EXERIS_K0110_J28P_PORT=${EXERIS_K0110_J28P_PORT:-9026}
SERVER_CPU_AFFINITY=${SERVER_CPU_AFFINITY:-}
EXERIS_JAVA_OPTS="--add-opens java.base/sun.nio.ch=ALL-UNNAMED --add-opens java.base/java.io=ALL-UNNAMED --enable-native-access=ALL-UNNAMED${EXERIS_JAVA_OPTS:+ ${EXERIS_JAVA_OPTS}}"
EXERIS_ENABLE_TELEMETRY_SUBSYSTEM=${EXERIS_ENABLE_TELEMETRY_SUBSYSTEM:-false}
EXERIS_TELEMETRY_JFR_ENABLED=${EXERIS_TELEMETRY_JFR_ENABLED:-${EXERIS_ENABLE_TELEMETRY_SUBSYSTEM:-false}}
EXERIS_JFR_VTHREAD_PINNED=${EXERIS_JFR_VTHREAD_PINNED:-false}
EXERIS_TRANSPORT_CERT_PATH=${EXERIS_TRANSPORT_CERT_PATH:-}
EXERIS_TRANSPORT_KEY_PATH=${EXERIS_TRANSPORT_KEY_PATH:-}
EXTERNAL_PID_FILE=${EXTERNAL_PID_FILE:-/tmp/exeris-${USER:-unknown}-exeris-k0110-j28p.pid}

EXTERNAL_START_CMD='EXERIS_PORT="$EXERIS_K0110_J28P_PORT" EXERIS_HTTP_MAX_VERSION="${EXERIS_HTTP_MAX_VERSION:-HTTP_1_1}" EXERIS_HTTP_H2C_UPGRADE_ENABLED="${EXERIS_HTTP_H2C_UPGRADE_ENABLED:-false}" EXERIS_TRANSPORT_CERT_PATH="${EXERIS_TRANSPORT_CERT_PATH:-}" EXERIS_TRANSPORT_KEY_PATH="${EXERIS_TRANSPORT_KEY_PATH:-}" EXERIS_DB_JDBC_URL="$EXERIS_DB_JDBC_URL" EXERIS_DB_USERNAME="$EXERIS_DB_USERNAME" EXERIS_DB_PASSWORD="$EXERIS_DB_PASSWORD" EXERIS_DB_POOL_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" EXERIS_DB_POOL_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" EXERIS_ENABLE_TELEMETRY_SUBSYSTEM="$EXERIS_ENABLE_TELEMETRY_SUBSYSTEM" EXERIS_TELEMETRY_JFR_ENABLED="$EXERIS_TELEMETRY_JFR_ENABLED" EXERIS_JFR_VTHREAD_PINNED="$EXERIS_JFR_VTHREAD_PINNED" ${TARGET_MEM_SCOPE_PREFIX:-}${SERVER_CPU_AFFINITY:+taskset -c ${SERVER_CPU_AFFINITY} }${ARM_JAVA_HOME}/bin/java $EXERIS_JAVA_OPTS --enable-preview -jar targets/_staging/exeris-community-app-k0.11.0-r28p.jar > /tmp/exeris-exeris-k0110-j28p-9026.log 2>&1 & echo $! > "$EXTERNAL_PID_FILE"'
EXTERNAL_STOP_CMD='if [[ -f "$EXTERNAL_PID_FILE" ]]; then pid="$(cat "$EXTERNAL_PID_FILE")"; kill "$pid" >/dev/null 2>&1 || true; rm -f "$EXTERNAL_PID_FILE"; fi'

TARGET_TIER=community
TARGET_PROTOCOL=h1
COMPARISON_AXIS=within-tier
