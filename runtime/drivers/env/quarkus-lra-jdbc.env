# Runtime target env for quarkus-lra-jdbc - the JDBC Quarkus arm of the
# CONTRACT-v2 §4 parking roster.
#
# Why this exists beside quarkus-tuned.env rather than extending it: quarkus-tuned.env is
# wired for the entity-read TLS work (its EXERIS_PORT is the SSL port), and the saga
# campaign and the entity-read campaign must be able to run without perturbing each other.
# A target id IS the deployment identity in this repo, so a different deployment gets a
# different id.
#
# Why the tuned jar and not quarkus-benchmark-app: every arm in this scenario is measured
# on JDBC because Exeris is. quarkus-benchmark-app carries quarkus-hibernate-orm-panache,
# and although its SAGA path is plain JDBC in both targets, the session's other steps
# (register / recommend / cart) go through Panache there - an ORM on one side of the
# comparison and not the other. This target is Agroal + plain JDBC throughout.
#
# The LRA coordinator is part of this arm's §1 deployment unit (app JVM + coordinator +
# Postgres = THREE processes) and must be sampled as such, exactly like Axon Server.

START_MODE=external
HEALTH_URL=http://localhost:9015/health
HEALTH_TIMEOUT_SECONDS=60

EXERIS_DB_JDBC_URL=${EXERIS_DB_JDBC_URL:-jdbc:postgresql://localhost:5432/postgres?prepareThreshold=1}
EXERIS_DB_USERNAME=${EXERIS_DB_USERNAME:-postgres}
EXERIS_DB_PASSWORD=${EXERIS_DB_PASSWORD:-postgres}
EXERIS_DB_POOL_MIN_SIZE=${EXERIS_DB_POOL_MIN_SIZE:-16}
EXERIS_DB_POOL_MAX_SIZE=${EXERIS_DB_POOL_MAX_SIZE:-256}
SERVER_CPU_AFFINITY=${SERVER_CPU_AFFINITY:-}
QUARKUS_JAVA_OPTS=${QUARKUS_JAVA_OPTS:-}
EXERIS_LRA_COORDINATOR_URL=${EXERIS_LRA_COORDINATOR_URL:-http://localhost:8090/lra-coordinator}
EXTERNAL_PID_FILE=${EXTERNAL_PID_FILE:-/tmp/exeris-${USER:-unknown}-quarkus-lra-jdbc.pid}

# Cleartext H1 only: the §4 payment gateway stub speaks plaintext HTTP/1.1, and the saga
# contract is h1 for every arm because k6 cannot drive cleartext HTTP/2. EXERIS_HTTP_PORT is
# where the app binds cleartext and defaults to EXERIS_PORT - letting them diverge is what
# left :9002 unbound with no cert and hung every readiness probe on the stock arm.
EXTERNAL_START_CMD='EXERIS_PORT=${EXERIS_PORT:-9015} EXERIS_HTTP_PORT="${EXERIS_HTTP_PORT:-${EXERIS_PORT:-9015}}" EXERIS_HTTP2_ENABLED="${EXERIS_HTTP2_ENABLED:-false}" EXERIS_INSECURE_REQUESTS="${EXERIS_INSECURE_REQUESTS:-enabled}" EXERIS_TRANSPORT_CERT_PATH="${EXERIS_TRANSPORT_CERT_PATH:-}" EXERIS_TRANSPORT_KEY_PATH="${EXERIS_TRANSPORT_KEY_PATH:-}" EXERIS_DB_JDBC_URL="$EXERIS_DB_JDBC_URL" EXERIS_DB_USERNAME="$EXERIS_DB_USERNAME" EXERIS_DB_PASSWORD="$EXERIS_DB_PASSWORD" EXERIS_DB_POOL_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" EXERIS_DB_POOL_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" QUARKUS_DATASOURCE_JDBC_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" QUARKUS_DATASOURCE_JDBC_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" EXERIS_LRA_COORDINATOR_URL="$EXERIS_LRA_COORDINATOR_URL" EXERIS_GRAPH_BACKEND_TYPE="${EXERIS_GRAPH_BACKEND_TYPE:-pgq}" EXERIS_GRAPH_NEO4J_URI="${EXERIS_GRAPH_NEO4J_URI:-bolt://localhost:7687}" EXERIS_GRAPH_NEO4J_USER="${EXERIS_GRAPH_NEO4J_USER:-neo4j}" EXERIS_GRAPH_NEO4J_PASSWORD="${EXERIS_GRAPH_NEO4J_PASSWORD:-password}" EXERIS_GRAPH_NEO4J_DATABASE="${EXERIS_GRAPH_NEO4J_DATABASE:-neo4j}" ${TARGET_MEM_SCOPE_PREFIX:-}${SERVER_CPU_AFFINITY:+taskset -c ${SERVER_CPU_AFFINITY} }"${JAVA_HOME:+$JAVA_HOME/bin/}java" $QUARKUS_JAVA_OPTS -jar targets/quarkus-benchmark-app-tuned/target/quarkus-benchmark-app-tuned-1.0.0-SNAPSHOT-runner.jar > /tmp/exeris-quarkus-lra-jdbc-9015.log 2>&1 & echo $! > "$EXTERNAL_PID_FILE"'
EXTERNAL_STOP_CMD='if [[ -f "$EXTERNAL_PID_FILE" ]]; then pid="$(cat "$EXTERNAL_PID_FILE")"; kill "$pid" >/dev/null 2>&1 || true; rm -f "$EXTERNAL_PID_FILE"; fi'

TARGET_TIER=community
TARGET_PROTOCOL=h1
COMPARISON_AXIS=within-tier
