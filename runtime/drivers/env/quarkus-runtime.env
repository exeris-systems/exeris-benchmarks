# Runtime target env for quarkus-jvm-vt-tuned.
# Concrete launcher contract used by comparative scripts.

START_MODE=external
HEALTH_TIMEOUT_SECONDS=60

EXERIS_DB_JDBC_URL=jdbc:postgresql://localhost:5432/postgres?prepareThreshold=1
EXERIS_DB_USERNAME=postgres
EXERIS_DB_PASSWORD=postgres
EXERIS_DB_POOL_MIN_SIZE=${EXERIS_DB_POOL_MIN_SIZE:-16}
EXERIS_DB_POOL_MAX_SIZE=${EXERIS_DB_POOL_MAX_SIZE:-256}
SERVER_CPU_AFFINITY=${SERVER_CPU_AFFINITY:-}
QUARKUS_JAVA_OPTS=${QUARKUS_JAVA_OPTS:-}
EXERIS_AXONSERVER_HOST=${EXERIS_AXONSERVER_HOST:-localhost}
EXERIS_AXONSERVER_PORT=${EXERIS_AXONSERVER_PORT:-8124}
EXTERNAL_PID_FILE=${EXTERNAL_PID_FILE:-/tmp/exeris-${USER:-unknown}-quarkus-runtime.pid}

EXTERNAL_START_CMD='if [[ -n "$SERVER_CPU_AFFINITY" ]]; then EXERIS_PORT=${EXERIS_PORT:-9002} EXERIS_HTTP2_ENABLED="${EXERIS_HTTP2_ENABLED:-true}" EXERIS_HTTP_PORT="${EXERIS_HTTP_PORT:-19002}" EXERIS_INSECURE_REQUESTS="${EXERIS_INSECURE_REQUESTS:-disabled}" EXERIS_TRANSPORT_CERT_PATH="${EXERIS_TRANSPORT_CERT_PATH:-}" EXERIS_TRANSPORT_KEY_PATH="${EXERIS_TRANSPORT_KEY_PATH:-}" EXERIS_DB_JDBC_URL="$EXERIS_DB_JDBC_URL" EXERIS_DB_USERNAME="$EXERIS_DB_USERNAME" EXERIS_DB_PASSWORD="$EXERIS_DB_PASSWORD" EXERIS_DB_POOL_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" EXERIS_DB_POOL_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" QUARKUS_DATASOURCE_JDBC_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" QUARKUS_DATASOURCE_JDBC_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" EXERIS_AXONSERVER_HOST="$EXERIS_AXONSERVER_HOST" EXERIS_AXONSERVER_PORT="$EXERIS_AXONSERVER_PORT" EXERIS_GRAPH_BACKEND_TYPE="${EXERIS_GRAPH_BACKEND_TYPE:-pgq}" EXERIS_GRAPH_NEO4J_URI="${EXERIS_GRAPH_NEO4J_URI:-bolt://localhost:7687}" EXERIS_GRAPH_NEO4J_USER="${EXERIS_GRAPH_NEO4J_USER:-neo4j}" EXERIS_GRAPH_NEO4J_PASSWORD="${EXERIS_GRAPH_NEO4J_PASSWORD:-password}" EXERIS_GRAPH_NEO4J_DATABASE="${EXERIS_GRAPH_NEO4J_DATABASE:-neo4j}" taskset -c "$SERVER_CPU_AFFINITY" java $QUARKUS_JAVA_OPTS -jar targets/quarkus-benchmark-app/target/quarkus-benchmark-app-1.0.0-SNAPSHOT-runner.jar > /tmp/exeris-quarkus-9002.log 2>&1 & else EXERIS_PORT=${EXERIS_PORT:-9002} EXERIS_HTTP2_ENABLED="${EXERIS_HTTP2_ENABLED:-true}" EXERIS_HTTP_PORT="${EXERIS_HTTP_PORT:-19002}" EXERIS_INSECURE_REQUESTS="${EXERIS_INSECURE_REQUESTS:-disabled}" EXERIS_TRANSPORT_CERT_PATH="${EXERIS_TRANSPORT_CERT_PATH:-}" EXERIS_TRANSPORT_KEY_PATH="${EXERIS_TRANSPORT_KEY_PATH:-}" EXERIS_DB_JDBC_URL="$EXERIS_DB_JDBC_URL" EXERIS_DB_USERNAME="$EXERIS_DB_USERNAME" EXERIS_DB_PASSWORD="$EXERIS_DB_PASSWORD" EXERIS_DB_POOL_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" EXERIS_DB_POOL_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" QUARKUS_DATASOURCE_JDBC_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" QUARKUS_DATASOURCE_JDBC_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" EXERIS_AXONSERVER_HOST="$EXERIS_AXONSERVER_HOST" EXERIS_AXONSERVER_PORT="$EXERIS_AXONSERVER_PORT" EXERIS_GRAPH_BACKEND_TYPE="${EXERIS_GRAPH_BACKEND_TYPE:-pgq}" EXERIS_GRAPH_NEO4J_URI="${EXERIS_GRAPH_NEO4J_URI:-bolt://localhost:7687}" EXERIS_GRAPH_NEO4J_USER="${EXERIS_GRAPH_NEO4J_USER:-neo4j}" EXERIS_GRAPH_NEO4J_PASSWORD="${EXERIS_GRAPH_NEO4J_PASSWORD:-password}" EXERIS_GRAPH_NEO4J_DATABASE="${EXERIS_GRAPH_NEO4J_DATABASE:-neo4j}" java $QUARKUS_JAVA_OPTS -jar targets/quarkus-benchmark-app/target/quarkus-benchmark-app-1.0.0-SNAPSHOT-runner.jar > /tmp/exeris-quarkus-9002.log 2>&1 & fi; echo $! > "$EXTERNAL_PID_FILE"'
EXTERNAL_STOP_CMD='if [[ -f "$EXTERNAL_PID_FILE" ]]; then pid="$(cat "$EXTERNAL_PID_FILE")"; kill "$pid" >/dev/null 2>&1 || true; rm -f "$EXTERNAL_PID_FILE"; fi'

TARGET_TIER=community
TARGET_PROTOCOL=h2c
COMPARISON_AXIS=within-tier
