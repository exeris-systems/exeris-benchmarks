# Runtime target env for quarkus-tuned (pure-JDBC / no ORM, native epoll +
# native BoringSSL transport). Structural twin of quarkus-runtime.env; the ONLY
# intended differences are the runner jar (quarkus-benchmark-app-tuned) and a
# SELF-SET port pair (9003/9444) so this target can co-reside with the
# quarkus-hibernate target (9002/9443) inside the same quarkus-focused triad.
#
# Port strategy: QUARKUS_HTTP_PORT / QUARKUS_HTTP_SSL_PORT are Quarkus-native env
# vars (Quarkus' own config layer maps them, overriding application.properties).
# The triad may export a GLOBAL QUARKUS_HTTP_PORT=9002 for the hibernate target;
# we override it INLINE here (dedicated QUARKUS_TUNED_* vars, default 9003/9444)
# so the tuned child process listens on its own port regardless of the global.
#
# Tuning axis: EXERIS_NETTY_NATIVE_TRANSPORT=true (native epoll — the epoll lib is
# an unconditional dep in this module's pom, so no -P profile is needed) and
# EXERIS_TLS_NATIVE=true (native BoringSSL; moot for the H1 cleartext entity run
# where no HTTPS listener is bound, but kept so the "tuned transport" identity is
# faithful for TLS scenarios). For H1 cleartext, epoll is the only live tuning.

START_MODE=external
HEALTH_TIMEOUT_SECONDS=60

EXERIS_DB_JDBC_URL=${EXERIS_DB_JDBC_URL:-jdbc:postgresql://localhost:5432/postgres?prepareThreshold=1}
EXERIS_DB_USERNAME=${EXERIS_DB_USERNAME:-postgres}
EXERIS_DB_PASSWORD=${EXERIS_DB_PASSWORD:-postgres}
EXERIS_DB_POOL_MIN_SIZE=${EXERIS_DB_POOL_MIN_SIZE:-16}
EXERIS_DB_POOL_MAX_SIZE=${EXERIS_DB_POOL_MAX_SIZE:-256}
QUARKUS_TUNED_HTTP_PORT=${QUARKUS_TUNED_HTTP_PORT:-9003}
QUARKUS_TUNED_SSL_PORT=${QUARKUS_TUNED_SSL_PORT:-9444}
EXERIS_NETTY_NATIVE_TRANSPORT=${EXERIS_NETTY_NATIVE_TRANSPORT:-true}
EXERIS_TLS_NATIVE=${EXERIS_TLS_NATIVE:-true}
SERVER_CPU_AFFINITY=${SERVER_CPU_AFFINITY:-}
QUARKUS_JAVA_OPTS=${QUARKUS_JAVA_OPTS:-}
EXERIS_AXONSERVER_HOST=${EXERIS_AXONSERVER_HOST:-localhost}
EXERIS_AXONSERVER_PORT=${EXERIS_AXONSERVER_PORT:-8124}
EXTERNAL_PID_FILE=${EXTERNAL_PID_FILE:-/tmp/exeris-${USER:-unknown}-quarkus-tuned.pid}

EXTERNAL_START_CMD='if [[ -n "$SERVER_CPU_AFFINITY" ]]; then QUARKUS_HTTP_PORT="$QUARKUS_TUNED_HTTP_PORT" QUARKUS_HTTP_SSL_PORT="$QUARKUS_TUNED_SSL_PORT" EXERIS_PORT="$QUARKUS_TUNED_SSL_PORT" EXERIS_HTTP_PORT="$QUARKUS_TUNED_HTTP_PORT" EXERIS_HTTP2_ENABLED="${EXERIS_HTTP2_ENABLED:-true}" EXERIS_INSECURE_REQUESTS="${EXERIS_INSECURE_REQUESTS:-enabled}" EXERIS_NETTY_NATIVE_TRANSPORT="$EXERIS_NETTY_NATIVE_TRANSPORT" EXERIS_TLS_NATIVE="$EXERIS_TLS_NATIVE" EXERIS_TRANSPORT_CERT_PATH="${EXERIS_TRANSPORT_CERT_PATH:-}" EXERIS_TRANSPORT_KEY_PATH="${EXERIS_TRANSPORT_KEY_PATH:-}" EXERIS_DB_JDBC_URL="$EXERIS_DB_JDBC_URL" EXERIS_DB_USERNAME="$EXERIS_DB_USERNAME" EXERIS_DB_PASSWORD="$EXERIS_DB_PASSWORD" EXERIS_DB_POOL_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" EXERIS_DB_POOL_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" QUARKUS_DATASOURCE_JDBC_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" QUARKUS_DATASOURCE_JDBC_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" EXERIS_AXONSERVER_HOST="$EXERIS_AXONSERVER_HOST" EXERIS_AXONSERVER_PORT="$EXERIS_AXONSERVER_PORT" EXERIS_GRAPH_BACKEND_TYPE="${EXERIS_GRAPH_BACKEND_TYPE:-pgq}" EXERIS_GRAPH_NEO4J_URI="${EXERIS_GRAPH_NEO4J_URI:-bolt://localhost:7687}" EXERIS_GRAPH_NEO4J_USER="${EXERIS_GRAPH_NEO4J_USER:-neo4j}" EXERIS_GRAPH_NEO4J_PASSWORD="${EXERIS_GRAPH_NEO4J_PASSWORD:-password}" EXERIS_GRAPH_NEO4J_DATABASE="${EXERIS_GRAPH_NEO4J_DATABASE:-neo4j}" taskset -c "$SERVER_CPU_AFFINITY" ${TARGET_MEM_SCOPE_PREFIX:-}"${JAVA_HOME:+$JAVA_HOME/bin/}java" $QUARKUS_JAVA_OPTS -jar targets/quarkus-benchmark-app-tuned/target/quarkus-benchmark-app-tuned-1.0.0-SNAPSHOT-runner.jar > /tmp/exeris-quarkus-tuned-9003.log 2>&1 & else QUARKUS_HTTP_PORT="$QUARKUS_TUNED_HTTP_PORT" QUARKUS_HTTP_SSL_PORT="$QUARKUS_TUNED_SSL_PORT" EXERIS_PORT="$QUARKUS_TUNED_SSL_PORT" EXERIS_HTTP_PORT="$QUARKUS_TUNED_HTTP_PORT" EXERIS_HTTP2_ENABLED="${EXERIS_HTTP2_ENABLED:-true}" EXERIS_INSECURE_REQUESTS="${EXERIS_INSECURE_REQUESTS:-enabled}" EXERIS_NETTY_NATIVE_TRANSPORT="$EXERIS_NETTY_NATIVE_TRANSPORT" EXERIS_TLS_NATIVE="$EXERIS_TLS_NATIVE" EXERIS_TRANSPORT_CERT_PATH="${EXERIS_TRANSPORT_CERT_PATH:-}" EXERIS_TRANSPORT_KEY_PATH="${EXERIS_TRANSPORT_KEY_PATH:-}" EXERIS_DB_JDBC_URL="$EXERIS_DB_JDBC_URL" EXERIS_DB_USERNAME="$EXERIS_DB_USERNAME" EXERIS_DB_PASSWORD="$EXERIS_DB_PASSWORD" EXERIS_DB_POOL_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" EXERIS_DB_POOL_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" QUARKUS_DATASOURCE_JDBC_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" QUARKUS_DATASOURCE_JDBC_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" EXERIS_AXONSERVER_HOST="$EXERIS_AXONSERVER_HOST" EXERIS_AXONSERVER_PORT="$EXERIS_AXONSERVER_PORT" EXERIS_GRAPH_BACKEND_TYPE="${EXERIS_GRAPH_BACKEND_TYPE:-pgq}" EXERIS_GRAPH_NEO4J_URI="${EXERIS_GRAPH_NEO4J_URI:-bolt://localhost:7687}" EXERIS_GRAPH_NEO4J_USER="${EXERIS_GRAPH_NEO4J_USER:-neo4j}" EXERIS_GRAPH_NEO4J_PASSWORD="${EXERIS_GRAPH_NEO4J_PASSWORD:-password}" EXERIS_GRAPH_NEO4J_DATABASE="${EXERIS_GRAPH_NEO4J_DATABASE:-neo4j}" ${TARGET_MEM_SCOPE_PREFIX:-}"${JAVA_HOME:+$JAVA_HOME/bin/}java" $QUARKUS_JAVA_OPTS -jar targets/quarkus-benchmark-app-tuned/target/quarkus-benchmark-app-tuned-1.0.0-SNAPSHOT-runner.jar > /tmp/exeris-quarkus-tuned-9003.log 2>&1 & fi; echo $! > "$EXTERNAL_PID_FILE"'
EXTERNAL_STOP_CMD='if [[ -f "$EXTERNAL_PID_FILE" ]]; then pid="$(cat "$EXTERNAL_PID_FILE")"; kill "$pid" >/dev/null 2>&1 || true; rm -f "$EXTERNAL_PID_FILE"; fi'

TARGET_TIER=community
TARGET_PROTOCOL=h2c
COMPARISON_AXIS=within-tier
