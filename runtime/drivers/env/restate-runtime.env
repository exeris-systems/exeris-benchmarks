# Runtime target env for restate (Restate JVM SDK saga target).
# Concrete launcher contract used by comparative scripts.
#
# Deployment unit (e2e-shop-order-saga CONTRACT-v2 s1): this JVM (k6-facing
# HTTP/1.1 facade on EXERIS_PORT 9004 + Restate SDK endpoint on
# RESTATE_SDK_PORT 9084) PLUS an external restate-server (ingress :8080,
# admin :9070). The saga baseline starts restate-server as compose service
# benchmark-restate-server (runtime/compose/e2e-shop-order-saga.yml); because
# the server runs in Docker it reaches the host-side SDK endpoint via
# host.docker.internal, hence the RESTATE_SDK_ADVERTISED_URL default below.
# The app self-registers its deployment against RESTATE_ADMIN_URL at startup
# (RESTATE_AUTO_REGISTER=true); the baseline additionally force-registers
# post-readiness so registration never depends on startup ordering.

START_MODE=external
HEALTH_URL=http://localhost:9004/health
HEALTH_TIMEOUT_SECONDS=60

EXERIS_DB_JDBC_URL=jdbc:postgresql://localhost:5432/postgres?prepareThreshold=1
EXERIS_DB_USERNAME=postgres
EXERIS_DB_PASSWORD=postgres
EXERIS_DB_POOL_MIN_SIZE=${EXERIS_DB_POOL_MIN_SIZE:-16}
EXERIS_DB_POOL_MAX_SIZE=${EXERIS_DB_POOL_MAX_SIZE:-256}
# neo4j matches the campaign --graph-track default; pgq is non-functional on a baseline-seeded DB (v4_pgq_graph.sql not applied).
EXERIS_GRAPH_BACKEND_TYPE=${EXERIS_GRAPH_BACKEND_TYPE:-neo4j}
SERVER_CPU_AFFINITY=${SERVER_CPU_AFFINITY:-}
RESTATE_JAVA_OPTS=${RESTATE_JAVA_OPTS:-}
RESTATE_SDK_PORT=${RESTATE_SDK_PORT:-9084}
RESTATE_INGRESS_URL=${RESTATE_INGRESS_URL:-http://localhost:8080}
RESTATE_ADMIN_URL=${RESTATE_ADMIN_URL:-http://localhost:9070}
RESTATE_SDK_ADVERTISED_URL=${RESTATE_SDK_ADVERTISED_URL:-http://host.docker.internal:9084}
RESTATE_AUTO_REGISTER=${RESTATE_AUTO_REGISTER:-true}
EXTERNAL_PID_FILE=${EXTERNAL_PID_FILE:-/tmp/exeris-${USER:-unknown}-restate-runtime.pid}

EXTERNAL_START_CMD='if [[ -n "$SERVER_CPU_AFFINITY" ]]; then EXERIS_PORT=${EXERIS_PORT:-9004} RESTATE_SDK_PORT="$RESTATE_SDK_PORT" RESTATE_INGRESS_URL="$RESTATE_INGRESS_URL" RESTATE_ADMIN_URL="$RESTATE_ADMIN_URL" RESTATE_SDK_ADVERTISED_URL="$RESTATE_SDK_ADVERTISED_URL" RESTATE_AUTO_REGISTER="$RESTATE_AUTO_REGISTER" EXERIS_DB_JDBC_URL="$EXERIS_DB_JDBC_URL" EXERIS_DB_USERNAME="$EXERIS_DB_USERNAME" EXERIS_DB_PASSWORD="$EXERIS_DB_PASSWORD" EXERIS_DB_POOL_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" EXERIS_DB_POOL_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" EXERIS_GRAPH_BACKEND_TYPE="$EXERIS_GRAPH_BACKEND_TYPE" EXERIS_GRAPH_NEO4J_URI="${EXERIS_GRAPH_NEO4J_URI:-bolt://localhost:7687}" EXERIS_GRAPH_NEO4J_USER="${EXERIS_GRAPH_NEO4J_USER:-neo4j}" EXERIS_GRAPH_NEO4J_PASSWORD="${EXERIS_GRAPH_NEO4J_PASSWORD:-password}" taskset -c "$SERVER_CPU_AFFINITY" "${JAVA_HOME:+$JAVA_HOME/bin/}java" $RESTATE_JAVA_OPTS --enable-native-access=ALL-UNNAMED -jar targets/restate-benchmark-app/target/restate-benchmark-app-1.0.0-SNAPSHOT.jar > /tmp/exeris-restate-9004.log 2>&1 & else EXERIS_PORT=${EXERIS_PORT:-9004} RESTATE_SDK_PORT="$RESTATE_SDK_PORT" RESTATE_INGRESS_URL="$RESTATE_INGRESS_URL" RESTATE_ADMIN_URL="$RESTATE_ADMIN_URL" RESTATE_SDK_ADVERTISED_URL="$RESTATE_SDK_ADVERTISED_URL" RESTATE_AUTO_REGISTER="$RESTATE_AUTO_REGISTER" EXERIS_DB_JDBC_URL="$EXERIS_DB_JDBC_URL" EXERIS_DB_USERNAME="$EXERIS_DB_USERNAME" EXERIS_DB_PASSWORD="$EXERIS_DB_PASSWORD" EXERIS_DB_POOL_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" EXERIS_DB_POOL_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" EXERIS_GRAPH_BACKEND_TYPE="$EXERIS_GRAPH_BACKEND_TYPE" EXERIS_GRAPH_NEO4J_URI="${EXERIS_GRAPH_NEO4J_URI:-bolt://localhost:7687}" EXERIS_GRAPH_NEO4J_USER="${EXERIS_GRAPH_NEO4J_USER:-neo4j}" EXERIS_GRAPH_NEO4J_PASSWORD="${EXERIS_GRAPH_NEO4J_PASSWORD:-password}" "${JAVA_HOME:+$JAVA_HOME/bin/}java" $RESTATE_JAVA_OPTS --enable-native-access=ALL-UNNAMED -jar targets/restate-benchmark-app/target/restate-benchmark-app-1.0.0-SNAPSHOT.jar > /tmp/exeris-restate-9004.log 2>&1 & fi; echo $! > "$EXTERNAL_PID_FILE"'
EXTERNAL_STOP_CMD='if [[ -f "$EXTERNAL_PID_FILE" ]]; then pid="$(cat "$EXTERNAL_PID_FILE")"; kill "$pid" >/dev/null 2>&1 || true; rm -f "$EXTERNAL_PID_FILE"; fi'

TARGET_TIER=community
TARGET_PROTOCOL=h1
COMPARISON_AXIS=within-tier
