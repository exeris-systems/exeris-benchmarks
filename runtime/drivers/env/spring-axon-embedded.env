# Runtime target env for spring-axon-embedded — CONTRACT-v2 §9(e) second Axon shape.
#
# SAME jar as spring-hibernate. The only difference is where Axon's event store, token
# store and saga store live:
#
#   spring-hibernate       EXERIS_AXON_SERVER_ENABLED=true  → AxonServerEventStore +
#                          AxonServerCommandBus. §1 deployment unit = target JVM +
#                          Postgres + Axon Server container (THREE processes).
#   spring-axon-embedded   EXERIS_AXON_SERVER_ENABLED=false → Spring Boot's Axon
#                          autoconfiguration falls back to the JPA event store,
#                          JpaTokenStore and JpaSagaStore against the SAME Postgres every
#                          other arm uses, with SimpleCommandBus in-process. §1 deployment
#                          unit = target JVM + Postgres (TWO processes).
#
# Why the second shape exists: the three-process shape puts a share of the saga engine's
# CPU and RSS in a container the target-JVM sampler cannot see, so a §8 footprint
# comparison against exeris-community (saga in-process) or the LRA arm reads as a
# difference in efficiency when part of it is a difference in where the work is hosted.
# This arm removes that confound by construction. Both are legitimate Axon deployments and
# BOTH are reported — neither is "the" Axon number.
#
# Port 9014: 9001 is spring-hibernate and the two arms must be able to coexist across
# consecutive reps without the second one binding onto the first one's leaked JVM.

START_MODE=external
HEALTH_URL=http://localhost:9014/health
HEALTH_TIMEOUT_SECONDS=60

EXERIS_DB_JDBC_URL=${EXERIS_DB_JDBC_URL:-jdbc:postgresql://localhost:5432/postgres?prepareThreshold=1}
EXERIS_DB_USERNAME=${EXERIS_DB_USERNAME:-postgres}
EXERIS_DB_PASSWORD=${EXERIS_DB_PASSWORD:-postgres}
EXERIS_DB_POOL_MIN_SIZE=${EXERIS_DB_POOL_MIN_SIZE:-16}
EXERIS_DB_POOL_MAX_SIZE=${EXERIS_DB_POOL_MAX_SIZE:-256}
SERVER_CPU_AFFINITY=${SERVER_CPU_AFFINITY:-}
SPRING_JAVA_OPTS=${SPRING_JAVA_OPTS:-}
EXTERNAL_PID_FILE=${EXTERNAL_PID_FILE:-/tmp/exeris-${USER:-unknown}-spring-axon-embedded.pid}

EXTERNAL_START_CMD='EXERIS_PORT=${EXERIS_PORT:-9014} EXERIS_HTTP2_ENABLED="${EXERIS_HTTP2_ENABLED:-false}" EXERIS_AXON_ENABLED=true EXERIS_AXON_SERVER_ENABLED=false EXERIS_DB_JDBC_URL="$EXERIS_DB_JDBC_URL" EXERIS_DB_USERNAME="$EXERIS_DB_USERNAME" EXERIS_DB_PASSWORD="$EXERIS_DB_PASSWORD" EXERIS_DB_POOL_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" EXERIS_DB_POOL_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" SPRING_DATASOURCE_URL="$EXERIS_DB_JDBC_URL" SPRING_DATASOURCE_USERNAME="$EXERIS_DB_USERNAME" SPRING_DATASOURCE_PASSWORD="$EXERIS_DB_PASSWORD" SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE="$EXERIS_DB_POOL_MIN_SIZE" SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE="$EXERIS_DB_POOL_MAX_SIZE" ${TARGET_MEM_SCOPE_PREFIX:-}${SERVER_CPU_AFFINITY:+taskset -c ${SERVER_CPU_AFFINITY} }java $SPRING_JAVA_OPTS -Dspring.classformat.ignore=true -jar targets/spring-benchmark-app/target/spring-benchmark-app-1.0.0-SNAPSHOT.jar > /tmp/exeris-spring-axon-embedded-9014.log 2>&1 & echo $! > "$EXTERNAL_PID_FILE"'
EXTERNAL_STOP_CMD='if [[ -f "$EXTERNAL_PID_FILE" ]]; then pid="$(cat "$EXTERNAL_PID_FILE")"; kill "$pid" >/dev/null 2>&1 || true; rm -f "$EXTERNAL_PID_FILE"; fi'

TARGET_TIER=community
TARGET_PROTOCOL=h1
COMPARISON_AXIS=within-tier
