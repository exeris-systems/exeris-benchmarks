# Runtime target env for spring-axon-jdbc - Axon Server event store, JDBC everywhere else.
#
# Why this exists beside spring-jdbc.env rather than extending it: spring-jdbc.env is wired
# for the entity-read work and never enables Axon, and the two campaigns must be able to run
# without perturbing each other. A target id IS the deployment identity in this repo.
#
# Why the -jdbc jar and not spring-benchmark-app: every arm in this scenario is measured on
# JDBC because Exeris is. spring-benchmark-app carries spring-boot-starter-data-jpa, and
# although its SAGA path is plain JDBC in both targets, the session's other steps (register /
# recommend / cart) go through JpaRepositories there - an ORM on one side of the comparison
# and not the other. This target is spring-boot-starter-jdbc throughout.
#
# Tokens and saga state are durable on BOTH Axon arms (AxonJdbcStateStoreConfig). Axon Server
# is an event store: it has no token-store and no saga-store API, and Axon's starter falls
# back to in-memory when no bean declares them, which is not a durable saga engine and would
# read as an efficiency advantage under §8.
#
# §1 deployment unit: target JVM + Postgres + Axon Server container (THREE processes).

START_MODE=external
HEALTH_URL=http://localhost:9016/health
HEALTH_TIMEOUT_SECONDS=60

EXERIS_DB_JDBC_URL=${EXERIS_DB_JDBC_URL:-jdbc:postgresql://localhost:5432/postgres?prepareThreshold=1}
EXERIS_DB_USERNAME=${EXERIS_DB_USERNAME:-postgres}
EXERIS_DB_PASSWORD=${EXERIS_DB_PASSWORD:-postgres}
EXERIS_DB_POOL_MIN_SIZE=${EXERIS_DB_POOL_MIN_SIZE:-16}
EXERIS_DB_POOL_MAX_SIZE=${EXERIS_DB_POOL_MAX_SIZE:-256}
SERVER_CPU_AFFINITY=${SERVER_CPU_AFFINITY:-}
SPRING_JAVA_OPTS=${SPRING_JAVA_OPTS:-}
EXERIS_AXONSERVER_HOST=${EXERIS_AXONSERVER_HOST:-localhost}
EXERIS_AXONSERVER_PORT=${EXERIS_AXONSERVER_PORT:-8124}
EXTERNAL_PID_FILE=${EXTERNAL_PID_FILE:-/tmp/exeris-${USER:-unknown}-spring-axon-jdbc.pid}

EXTERNAL_START_CMD='EXERIS_PORT=${EXERIS_PORT:-9016} EXERIS_HTTP2_ENABLED="${EXERIS_HTTP2_ENABLED:-false}" EXERIS_AXON_ENABLED=true EXERIS_AXON_SERVER_ENABLED=true EXERIS_AXONSERVER_HOST="$EXERIS_AXONSERVER_HOST" EXERIS_AXONSERVER_PORT="$EXERIS_AXONSERVER_PORT" EXERIS_DB_JDBC_URL="$EXERIS_DB_JDBC_URL" EXERIS_DB_USERNAME="$EXERIS_DB_USERNAME" EXERIS_DB_PASSWORD="$EXERIS_DB_PASSWORD" EXERIS_DB_POOL_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" EXERIS_DB_POOL_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" SPRING_DATASOURCE_URL="$EXERIS_DB_JDBC_URL" SPRING_DATASOURCE_USERNAME="$EXERIS_DB_USERNAME" SPRING_DATASOURCE_PASSWORD="$EXERIS_DB_PASSWORD" SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE="$EXERIS_DB_POOL_MIN_SIZE" SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE="$EXERIS_DB_POOL_MAX_SIZE" ${TARGET_MEM_SCOPE_PREFIX:-}${SERVER_CPU_AFFINITY:+taskset -c ${SERVER_CPU_AFFINITY} }java $SPRING_JAVA_OPTS -Dspring.classformat.ignore=true -jar targets/spring-benchmark-app-jdbc/target/spring-benchmark-app-jdbc-1.0.0-SNAPSHOT.jar > /tmp/exeris-spring-axon-jdbc-9016.log 2>&1 & echo $! > "$EXTERNAL_PID_FILE"'
EXTERNAL_STOP_CMD='if [[ -f "$EXTERNAL_PID_FILE" ]]; then pid="$(cat "$EXTERNAL_PID_FILE")"; kill "$pid" >/dev/null 2>&1 || true; rm -f "$EXTERNAL_PID_FILE"; fi'

TARGET_TIER=community
TARGET_PROTOCOL=h1
COMPARISON_AXIS=within-tier
