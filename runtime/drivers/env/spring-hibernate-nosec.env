# Runtime target env for spring-hibernate-nosec — the SAME jar as spring-hibernate, launched with
# the servlet SecurityFilterChain turned off. Its only purpose is to bound the security confound
# in the hosting rung (docs/CLAIMS.md L3, report §6): spring-hibernate runs a per-request
# authorization decision that spring-on-exeris-pure does not, and that difference has never been
# measured on the Tomcat side.
#
# ONE JAR, ONE VARIABLE. This launches targets/spring-benchmark-app/target/...jar — byte-identical
# to the stock arm, same artifact_sha256 — so classpath, loaded classes and metaspace are held
# constant and RSS stays comparable. Only the filter chain moves. Building a second module without
# spring-boot-starter-security would have changed all of those at once.
#
# THE EXCLUSION LIST IS BOOT-4 SPECIFIC AND WAS WRONG ON THE FIRST ATTEMPT. In Boot 4 the security
# auto-configurations moved OUT of spring-boot-autoconfigure into spring-boot-security and
# spring-boot-security-oauth2-resource-server, and the packages changed from
# org.springframework.boot.autoconfigure.security.* to org.springframework.boot.security.autoconfigure.*.
# Boot-3 names silently match nothing: the app started clean, logged no error, and served 401 from
# the default chain — i.e. the arm looked healthy while measuring the opposite of what was asked.
# Caught only because boot-verify curls the endpoints without an Authorization header. If this list
# ever needs editing, list the real names first:
#   unzip -l <jar> | grep spring-boot-security
#
# SEVEN EXCLUSIONS, NOT ONE. Disabling the app's own filter-chain bean is not enough:
# with the starter still on the classpath, Boot's SecurityAutoConfiguration supplies a DEFAULT
# chain (HTTP basic + form login), which is MORE per-request work than the app's permitAll chain,
# and the arm would come out SLOWER for a reason that has nothing to do with the question. The
# auto-configurations are therefore excluded explicitly.
#
# BOOT-VERIFY CONTRACT: after launch the log must contain no springSecurityFilterChain
# registration, and both read endpoints must return 200 WITHOUT an Authorization header. If a 401
# appears, the chain is still active (see SecurityConfig's note about the unauthorized /error
# forward, which makes any failure look like an auth problem).

START_MODE=external
HEALTH_URL=http://localhost:9009/health
HEALTH_TIMEOUT_SECONDS=60

EXERIS_DB_JDBC_URL=${EXERIS_DB_JDBC_URL:-jdbc:postgresql://localhost:5432/postgres?prepareThreshold=1}
EXERIS_DB_USERNAME=${EXERIS_DB_USERNAME:-postgres}
EXERIS_DB_PASSWORD=${EXERIS_DB_PASSWORD:-postgres}
EXERIS_DB_POOL_MIN_SIZE=${EXERIS_DB_POOL_MIN_SIZE:-16}
EXERIS_DB_POOL_MAX_SIZE=${EXERIS_DB_POOL_MAX_SIZE:-256}
SERVER_CPU_AFFINITY=${SERVER_CPU_AFFINITY:-}
SPRING_JAVA_OPTS=${SPRING_JAVA_OPTS:-}
EXERIS_AXONSERVER_HOST=${EXERIS_AXONSERVER_HOST:-localhost}
EXERIS_AXONSERVER_PORT=${EXERIS_AXONSERVER_PORT:-8124}
EXTERNAL_PID_FILE=${EXTERNAL_PID_FILE:-/tmp/exeris-${USER:-unknown}-spring-hibernate-nosec.pid}

NOSEC_EXCLUDES=org.springframework.boot.security.autoconfigure.SecurityAutoConfiguration,org.springframework.boot.security.autoconfigure.UserDetailsServiceAutoConfiguration,org.springframework.boot.security.autoconfigure.web.servlet.ServletWebSecurityAutoConfiguration,org.springframework.boot.security.autoconfigure.web.servlet.SecurityFilterAutoConfiguration,org.springframework.boot.security.autoconfigure.actuate.web.servlet.ManagementWebSecurityAutoConfiguration,org.springframework.boot.security.oauth2.server.resource.autoconfigure.OAuth2ResourceServerAutoConfiguration,org.springframework.boot.security.oauth2.server.resource.autoconfigure.web.OAuth2ResourceServerWebSecurityAutoConfiguration

EXTERNAL_START_CMD='if [[ -n "$SERVER_CPU_AFFINITY" ]]; then EXERIS_PORT=${EXERIS_PORT:-9009} EXERIS_HTTP2_ENABLED="${EXERIS_HTTP2_ENABLED:-true}" EXERIS_DB_JDBC_URL="$EXERIS_DB_JDBC_URL" EXERIS_DB_USERNAME="$EXERIS_DB_USERNAME" EXERIS_DB_PASSWORD="$EXERIS_DB_PASSWORD" EXERIS_DB_POOL_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" EXERIS_DB_POOL_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" SPRING_DATASOURCE_URL="$EXERIS_DB_JDBC_URL" SPRING_DATASOURCE_USERNAME="$EXERIS_DB_USERNAME" SPRING_DATASOURCE_PASSWORD="$EXERIS_DB_PASSWORD" SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE="$EXERIS_DB_POOL_MIN_SIZE" SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE="$EXERIS_DB_POOL_MAX_SIZE" EXERIS_AXONSERVER_HOST="$EXERIS_AXONSERVER_HOST" EXERIS_AXONSERVER_PORT="$EXERIS_AXONSERVER_PORT" taskset -c "$SERVER_CPU_AFFINITY" java $SPRING_JAVA_OPTS -Dspring.classformat.ignore=true -Dbenchmark.security.filter-chain.enabled=false -Dspring.autoconfigure.exclude="$NOSEC_EXCLUDES" -jar targets/spring-benchmark-app/target/spring-benchmark-app-1.0.0-SNAPSHOT.jar > /tmp/exeris-spring-nosec-9009.log 2>&1 & else EXERIS_PORT=${EXERIS_PORT:-9009} EXERIS_HTTP2_ENABLED="${EXERIS_HTTP2_ENABLED:-true}" EXERIS_DB_JDBC_URL="$EXERIS_DB_JDBC_URL" EXERIS_DB_USERNAME="$EXERIS_DB_USERNAME" EXERIS_DB_PASSWORD="$EXERIS_DB_PASSWORD" EXERIS_DB_POOL_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" EXERIS_DB_POOL_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" SPRING_DATASOURCE_URL="$EXERIS_DB_JDBC_URL" SPRING_DATASOURCE_USERNAME="$EXERIS_DB_USERNAME" SPRING_DATASOURCE_PASSWORD="$EXERIS_DB_PASSWORD" SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE="$EXERIS_DB_POOL_MIN_SIZE" SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE="$EXERIS_DB_POOL_MAX_SIZE" EXERIS_AXONSERVER_HOST="$EXERIS_AXONSERVER_HOST" EXERIS_AXONSERVER_PORT="$EXERIS_AXONSERVER_PORT" java $SPRING_JAVA_OPTS -Dspring.classformat.ignore=true -Dbenchmark.security.filter-chain.enabled=false -Dspring.autoconfigure.exclude="$NOSEC_EXCLUDES" -jar targets/spring-benchmark-app/target/spring-benchmark-app-1.0.0-SNAPSHOT.jar > /tmp/exeris-spring-nosec-9009.log 2>&1 & fi; echo $! > "$EXTERNAL_PID_FILE"'
EXTERNAL_STOP_CMD='if [[ -f "$EXTERNAL_PID_FILE" ]]; then pid="$(cat "$EXTERNAL_PID_FILE")"; kill "$pid" >/dev/null 2>&1 || true; rm -f "$EXTERNAL_PID_FILE"; fi'

TARGET_TIER=community
TARGET_PROTOCOL=h1
COMPARISON_AXIS=within-tier
