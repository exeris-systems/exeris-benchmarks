# Spring-on-Exeris PURE MODE (targets/exeris-spring-runtime-app-pure).
#
# Third arm of the Spring hosting comparison. Differs from spring-runtime-on-exeris.env only
# in the jar it launches and the port; every other setting is deliberately identical so the
# Pure-vs-Compat axis stays a web-layer axis.
#
# PORT 9005: chosen so all three arms can co-reside — spring-hibernate 9001,
# spring-on-exeris (compat) 9004, this 9005. NOTE 9005 is also exeris-blackbird's port; the
# two are never paired, but do not launch them together.
#
# CONTRACT SCOPE: heavy (fixed_contract_cross_runtime_h1_v2) only. The light single-read
# contract is blocked — pure mode cannot resolve a route whose request carries a query string.
# See targets/exeris-spring-runtime-app-pure/README.md, "Blocker".
TARGET_ID=spring-on-exeris-pure
HEALTH_URL=http://localhost:9005/health
HEALTH_TIMEOUT_SECONDS=90

SPRING_ON_EXERIS_PURE_PORT=${SPRING_ON_EXERIS_PURE_PORT:-9005}

SPRING_JAVA_OPTS=${SPRING_JAVA_OPTS:-}
# --enable-preview is mandatory: kernel classes are compiled with preview features
# (class file 70.65535) and ExerisRuntimeLifecycle fails to start without it.
# -Dspring.classformat.ignore=true keeps Spring's classpath scan off those preview classes.
# Appended AFTER SPRING_JAVA_OPTS so heap/JFR settings win.
EXERIS_NATIVE_JAVA_OPTS=${EXERIS_NATIVE_JAVA_OPTS:-'--add-opens java.base/sun.nio.ch=ALL-UNNAMED --add-opens java.base/java.io=ALL-UNNAMED --enable-native-access=ALL-UNNAMED --enable-preview -Dspring.classformat.ignore=true'}

# Required by runtime/drivers/start-target.sh: the start command ends with
# `echo $! > "$EXTERNAL_PID_FILE"`. Unset, that redirect targets an empty path and
# bash reports `line 1: : No such file or directory`. The JVM has already launched by
# then, so the failure is doubly misleading — start-target.sh reports the target as
# failed to start while an orphaned process keeps holding the port, and the NEXT
# attempt then reports 'port 9005 is occupied'. Both sibling env files declare it.
EXTERNAL_PID_FILE=${EXTERNAL_PID_FILE:-/tmp/exeris-${USER:-unknown}-spring-on-exeris-pure.pid}

EXTERNAL_START_CMD='EXERIS_PORT="$SPRING_ON_EXERIS_PURE_PORT" EXERIS_DB_JDBC_URL="$EXERIS_DB_JDBC_URL" EXERIS_DB_USERNAME="$EXERIS_DB_USERNAME" EXERIS_DB_PASSWORD="$EXERIS_DB_PASSWORD" EXERIS_DB_POOL_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" EXERIS_DB_POOL_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" SPRING_DATASOURCE_URL="$EXERIS_DB_JDBC_URL" SPRING_DATASOURCE_USERNAME="$EXERIS_DB_USERNAME" SPRING_DATASOURCE_PASSWORD="$EXERIS_DB_PASSWORD" ${SERVER_CPU_AFFINITY:+taskset -c ${SERVER_CPU_AFFINITY} }java $SPRING_JAVA_OPTS $EXERIS_NATIVE_JAVA_OPTS -jar targets/exeris-spring-runtime-app-pure/target/spring-benchmark-app-pure-1.0.0-SNAPSHOT.jar > /tmp/exeris-spring-on-exeris-pure-9005.log 2>&1 & echo $! > "$EXTERNAL_PID_FILE"'
