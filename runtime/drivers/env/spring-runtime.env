# Runtime target env for spring-jvm-vt-tuned.
# Concrete launcher contract used by comparative scripts.

START_MODE=external
HEALTH_URL=http://localhost:9001/health
HEALTH_TIMEOUT_SECONDS=60

EXERIS_DB_JDBC_URL=${EXERIS_DB_JDBC_URL:-jdbc:postgresql://localhost:5432/postgres?prepareThreshold=1}
EXERIS_DB_USERNAME=${EXERIS_DB_USERNAME:-postgres}
EXERIS_DB_PASSWORD=${EXERIS_DB_PASSWORD:-postgres}
EXERIS_DB_POOL_MIN_SIZE=${EXERIS_DB_POOL_MIN_SIZE:-16}
EXERIS_DB_POOL_MAX_SIZE=${EXERIS_DB_POOL_MAX_SIZE:-256}
SERVER_CPU_AFFINITY=${SERVER_CPU_AFFINITY:-}
SPRING_JAVA_OPTS=${SPRING_JAVA_OPTS:-}
EXERIS_AXONSERVER_HOST=${EXERIS_AXONSERVER_HOST:-localhost}
EXERIS_AXONSERVER_PORT=${EXERIS_AXONSERVER_PORT:-8124}
EXTERNAL_PID_FILE=${EXTERNAL_PID_FILE:-/tmp/exeris-${USER:-unknown}-spring-runtime.pid}

EXTERNAL_START_CMD='if [[ -n "$SERVER_CPU_AFFINITY" ]]; then EXERIS_PORT=${EXERIS_PORT:-9001} EXERIS_HTTP2_ENABLED="${EXERIS_HTTP2_ENABLED:-true}" EXERIS_DB_JDBC_URL="$EXERIS_DB_JDBC_URL" EXERIS_DB_USERNAME="$EXERIS_DB_USERNAME" EXERIS_DB_PASSWORD="$EXERIS_DB_PASSWORD" EXERIS_DB_POOL_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" EXERIS_DB_POOL_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" SPRING_DATASOURCE_URL="$EXERIS_DB_JDBC_URL" SPRING_DATASOURCE_USERNAME="$EXERIS_DB_USERNAME" SPRING_DATASOURCE_PASSWORD="$EXERIS_DB_PASSWORD" SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE="$EXERIS_DB_POOL_MIN_SIZE" SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE="$EXERIS_DB_POOL_MAX_SIZE" EXERIS_AXONSERVER_HOST="$EXERIS_AXONSERVER_HOST" EXERIS_AXONSERVER_PORT="$EXERIS_AXONSERVER_PORT" taskset -c "$SERVER_CPU_AFFINITY" java $SPRING_JAVA_OPTS -Dspring.classformat.ignore=true -jar targets/spring-benchmark-app/target/spring-benchmark-app-1.0.0-SNAPSHOT.jar > /tmp/exeris-spring-9001.log 2>&1 & else EXERIS_PORT=${EXERIS_PORT:-9001} EXERIS_HTTP2_ENABLED="${EXERIS_HTTP2_ENABLED:-true}" EXERIS_DB_JDBC_URL="$EXERIS_DB_JDBC_URL" EXERIS_DB_USERNAME="$EXERIS_DB_USERNAME" EXERIS_DB_PASSWORD="$EXERIS_DB_PASSWORD" EXERIS_DB_POOL_MIN_SIZE="$EXERIS_DB_POOL_MIN_SIZE" EXERIS_DB_POOL_MAX_SIZE="$EXERIS_DB_POOL_MAX_SIZE" SPRING_DATASOURCE_URL="$EXERIS_DB_JDBC_URL" SPRING_DATASOURCE_USERNAME="$EXERIS_DB_USERNAME" SPRING_DATASOURCE_PASSWORD="$EXERIS_DB_PASSWORD" SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE="$EXERIS_DB_POOL_MIN_SIZE" SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE="$EXERIS_DB_POOL_MAX_SIZE" EXERIS_AXONSERVER_HOST="$EXERIS_AXONSERVER_HOST" EXERIS_AXONSERVER_PORT="$EXERIS_AXONSERVER_PORT" java $SPRING_JAVA_OPTS -Dspring.classformat.ignore=true -jar targets/spring-benchmark-app/target/spring-benchmark-app-1.0.0-SNAPSHOT.jar > /tmp/exeris-spring-9001.log 2>&1 & fi; echo $! > "$EXTERNAL_PID_FILE"'
EXTERNAL_STOP_CMD='if [[ -f "$EXTERNAL_PID_FILE" ]]; then pid="$(cat "$EXTERNAL_PID_FILE")"; kill "$pid" >/dev/null 2>&1 || true; rm -f "$EXTERNAL_PID_FILE"; fi'

TARGET_TIER=community
TARGET_PROTOCOL=h2c
COMPARISON_AXIS=within-tier
