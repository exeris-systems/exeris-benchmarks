# Template target environment configuration.
# Copy to env/<target>.env and fill in values.
#
# START_MODE: docker | jar | external
START_MODE=docker

# For START_MODE=docker:
COMPOSE_FILE=runtime/drivers/docker-compose/community.yml

# For START_MODE=jar:
# JAR_PATH=path/to/exeris-kernel-community-app.jar
# JVM_FLAGS=-XX:+UseG1GC -Xms512m -Xmx512m

# For START_MODE=external (private/proprietary executor):
# EXTERNAL_START_CMD=/opt/exeris-enterprise-bench/run-start.sh
# EXTERNAL_STOP_CMD=/opt/exeris-enterprise-bench/run-stop.sh

# Health check
HEALTH_URL=http://localhost:8080/health
HEALTH_TIMEOUT_SECONDS=60

# wrk target
WRK_BASE_URL=http://localhost:8080
WRK_PATH=/plaintext
WRK_THREADS=4
WRK_CONNECTIONS=100
WRK_DURATION=30s

# h2load target
H2LOAD_BASE_URL=https://localhost:8443
H2LOAD_PATH=/plaintext
H2LOAD_CLIENTS=100
H2LOAD_MAX_STREAMS=10
H2LOAD_TOTAL_REQUESTS=1000000
