BASE_URL=http://localhost:8080
# Load shape (phase durations/rates/VU pools) lives in k6.js defaults (120s warmup /
# 180s measurement / 30s cooldown); override via K6_WARMUP_DURATION / K6_MEASURE_DURATION /
# K6_COOLDOWN_DURATION and the matching _RATE / _VUS_* knobs. The former K6_VUS /
# K6_DURATION / K6_RAMP_UP entries were dead: bench_read_k6_defaults blocklists them as
# k6 system vars (they would replace the script's scenarios with a plain default scenario).
# K6_WARMUP_TIME / K6_MEASUREMENT_TIME were dead too: renamed — k6.js reads only the
# *_DURATION spellings above.
K6_THINK_TIME_MIN=800
K6_THINK_TIME_MAX=2500
K6_MAX_REDIRECTS=5
K6_TIMEOUT=30s
# CONTRACT-v2 §3: fixed orderId seed — the same deterministic orderId set is issued in every
# run against every stack (format documented in k6.js generateOrderId / ORDER_SEED).
K6_ORDER_SEED=exeris-saga-v2
# Legacy pre-v2 knobs: still forwarded for targets that read them, but k6.js accepts and
# ignores both (CONTRACT-v2 §4.1 pins a deterministic per-orderId 3.0% decline, server-side).
EXERIS_SAGA_PAYMENT_FAIL_RATE=0.03
K6_SAGA_EXPECTED_COMPENSATION_RATE=0.03

# CONTRACT-v2 §2.1 shape A windows, pinned 2026-08-18 and aligned with the
# entity-read fixed contracts (300 s / 900 s), which are the precedent in this repo.
#
# The previous 120/180 gave 9 000 sagas per measurement window. At a 3.0% decline that
# is ~270 compensations — a thin denominator for the §4.1 exact oracle, and thin for
# tail percentiles on a workload whose whole point is a park. 900 s gives ~45 000 sagas
# and ~1 350 compensations.
K6_WARMUP_DURATION=300s
K6_MEASURE_DURATION=900s
K6_COOLDOWN_DURATION=30s

# CONTRACT-v2 §2 arrival rate — 38 sessions/s, NORMATIVE, re-rated 2026-08-19.
#
# 50/s was NOT sustainable and had never been validated for this workload shape. It
# came from a sweep run under the straight-through shape A0, where nothing parks, and
# was carried across the shape boundary unchanged when parking was introduced — the
# one thing §2.1 says must never happen. Under the parking shape both Axon arms retire
# ~45.6 sagas/s, so at 50/s they were in permanent overload: in-flight work climbed
# monotonically for an entire 11-minute window (545 → 2882 concurrent) and never
# reached steady state.
#
# What that did to the numbers is the reason this is pinned rather than left to a knob.
# In overload a percentile measures how far the queue grew before the window closed, so
# it scales with WINDOW LENGTH, not with the system: the same jar reported a saga p95 of
# 10.5 s at a 100 s window and 52 s at a 690 s one. At a sustainable rate the same arm
# reports 401 ms. Every one of those is "the p95"; only the last is a property of the
# stack.
#
# 38/s is a MEASURED clean plateau on every arm tested there (capacity ladder,
# 2026-08-19), with ~17 % headroom under the binding arm:
#
#   spring-axon-jdbc           30 ✓  38 ✓  46 ✗ climbing   capacity ~45.6/s
#   spring-axon-embedded-jdbc  30 ✓  38 ✓  46 ✗ climbing   capacity ~45.7/s
#   quarkus-lra-jdbc           38 ✓  46 ✓  54 ✓            capacity >54/s
#   exeris-community           50 ✓  65 ✗  80 ✗ COLLAPSE   ceiling 50–65/s
#
# exeris-community is the reason the headroom is not trimmed further: it does not
# degrade gracefully at its ceiling, it fails — 36 % of requests erroring and 14 566
# iterations never reaching order submission at 65/s. Sitting close to any arm's ceiling
# makes the whole campaign hostage to small capacity changes, which is also how a stack
# that drifted 5 % turned into a 5× latency swing.
#
# Runs at 50/s MUST NOT be aggregated with runs at 38/s; the boundary is carried by the
# `r38` token in workload_profile_key.
K6_WARMUP_RATE=38
K6_MEASURE_RATE=38
K6_COOLDOWN_RATE=38

# VU pools are a CEILING, not concurrency. At 38/s with ~6.8 s iterations, Little's law
# puts steady-state concurrency near 260, so 400/500 pre-allocated is comfortable and no
# iteration should ever wait for a VU.
#
# Keep the headroom even though 260 fits. The pool must never become the thing that
# limits in-flight work: a pool that binds caps concurrency and FLATTENS the queue-growth
# curve, which is the one signal separating "at capacity" from "in overload". Sizing
# these down to the expected concurrency would be optimising away the instrument, and k6
# reports pool exhaustion as dropped_iterations, which nothing here gates on — so the
# failure would be silent as well as invisible.
K6_WARMUP_VUS_PRE=400
K6_WARMUP_VUS_MAX=1000
K6_MEASURE_VUS_PRE=500
K6_MEASURE_VUS_MAX=1000
K6_COOLDOWN_VUS_PRE=500
K6_COOLDOWN_VUS_MAX=1000
