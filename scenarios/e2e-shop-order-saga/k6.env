BASE_URL=http://localhost:8080
# Load shape (phase durations/rates/VU pools) lives in k6.js defaults (120s warmup /
# 180s measurement / 30s cooldown); override via K6_WARMUP_DURATION / K6_MEASURE_DURATION /
# K6_COOLDOWN_DURATION and the matching _RATE / _VUS_* knobs. The former K6_VUS /
# K6_DURATION / K6_RAMP_UP entries were dead: bench_read_k6_defaults blocklists them as
# k6 system vars (they would replace the script's scenarios with a plain default scenario).
# K6_WARMUP_TIME / K6_MEASUREMENT_TIME were dead too: renamed — k6.js reads only the
# *_DURATION spellings above.
K6_THINK_TIME_MIN=800
K6_THINK_TIME_MAX=2500
K6_MAX_REDIRECTS=5
K6_TIMEOUT=30s
# CONTRACT-v2 §3: fixed orderId seed — the same deterministic orderId set is issued in every
# run against every stack (format documented in k6.js generateOrderId / ORDER_SEED).
K6_ORDER_SEED=exeris-saga-v2
# Legacy pre-v2 knobs: still forwarded for targets that read them, but k6.js accepts and
# ignores both (CONTRACT-v2 §4.1 pins a deterministic per-orderId 3.0% decline, server-side).
EXERIS_SAGA_PAYMENT_FAIL_RATE=0.03
K6_SAGA_EXPECTED_COMPENSATION_RATE=0.03

# CONTRACT-v2 §2.1 shape A windows, pinned 2026-08-18 and aligned with the
# entity-read fixed contracts (300 s / 900 s), which are the precedent in this repo.
#
# The previous 120/180 gave 9 000 sagas per measurement window. At a 3.0% decline that
# is ~270 compensations — a thin denominator for the §4.1 exact oracle, and thin for
# tail percentiles on a workload whose whole point is a park. 900 s gives ~45 000 sagas
# and ~1 350 compensations.
K6_WARMUP_DURATION=300s
K6_MEASURE_DURATION=900s
K6_COOLDOWN_DURATION=30s
