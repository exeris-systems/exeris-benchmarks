# entity-read-by-id k6 soak defaults — EXPLORATORY-ONLY.
# The k6 driver is NOT the wrk-defined comparison contract for this scenario
# (fixed_contract_cross_runtime_h1_v1 is wrk/wrk2/h2load); k6 soak results are
# never comparison-eligible. See scenarios/entity-read-by-id/k6.js header.
#
# NOTE: scripts/run-k6.sh does NOT source this file — pass knobs as
# `--env KEY=value` args (they reach the script via __ENV). This file is the
# documented default set, consumable by bench_read_k6_defaults-style runners.
#
# The soak duration knob is K6_SOAK_DURATION, NOT K6_DURATION: K6_DURATION is
# a k6 SYSTEM option that clobbers the arrival-rate scenarios when it reaches
# k6's config layer (OS env always; --env too on k6 v1.4.2), turning the run
# closed-loop/CO-contaminated — the k6.js setup() guard aborts such runs.
BASE_URL=http://localhost:8080
K6_RATE=50
K6_SOAK_DURATION=1h
K6_PREALLOC_VUS=20
K6_MAX_VUS=100
K6_WARMUP_RATE=50
K6_WARMUP_DURATION=120s
K6_COOLDOWN_RATE=50
K6_COOLDOWN_DURATION=60s
K6_HOT_RATIO=0.8
K6_HOT_SET_SIZE=50
K6_ID_MIN=1
K6_ID_MAX=1000
K6_USERS_WEIGHT=0.90
K6_DB_PING_WEIGHT=0.05
K6_HEALTH_WEIGHT=0.05
K6_TIMEOUT=10s
K6_TRANSPORT_MODE=loopback-h1
