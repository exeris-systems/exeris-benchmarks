{
  "scenario_id": "entity-read-by-id",
  "version": "1",
  "endpoint": "GET /api/v1/users",
  "mode": "baseline-db",
  "backend_modes": {
    "comparison_type": "intra-target-backend-mode",
    "baseline": "default-vt",
    "candidate": "locality-aware",
    "semantics": "Compare backend execution mode within the same community H1 target under an identical fixed contract.",
    "locality_strict_default": false
  },
  "tier": "community",
  "benchmark_family": "runtime",
  "driver": [
    "wrk",
    "h2load",
    "wrk2"
  ],
  "transport": [
    "h1",
    "h2c"
  ],
  "loopback": true,
  "loopback_caveat": "Results are not equivalent to network-path benchmarks. transport_mode=loopback-h1 is mandatory in all result artifacts.",
  "claim_scope": "comparison_eligible",
  "concurrency": {
    "connections": 128,
    "threads": 4,
    "note": "128 connections may undersaturate DB; connection_pool_size is a declared fixed variable."
  },
  "db": {
    "type": "postgresql",
    "image": "postgres:16.2",
    "schema_migration_version": "V1",
    "connection_pool_size": 10,
    "connection_pool_size_status": "declared_fixed_variable"
  },
  "seed": {
    "manifest_ref": "scenarios/entity-read-by-id/seed/seed-manifest.json",
    "manifest_version": "1",
    "idempotency": "INSERT ... ON CONFLICT (id) DO UPDATE",
    "pre_run_verification": "row_count_and_hash",
    "verification_script": "scenarios/entity-read-by-id/seed/verify-seed.sh",
    "idempotency_guarantee": "Re-running entities.sql produces identical state across users, interests, friendships, user_interests, and compatibility entities tables. Results without passing pre-run verification are invalid."
  },
  "fixed_contracts": {
    "fixed_contract_v1": {
