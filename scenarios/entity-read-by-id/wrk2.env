WRK2_BASE_URL=http://localhost:8080
WRK2_PATH=/api/v1/users
WRK2_THREADS=4
WRK2_CONNECTIONS=128
WRK2_WARMUP=60s
WRK2_DURATION=120s
# Rate must be calibrated from wrk exploratory output (set to ~70% of observed saturation RPS).
# Default is a conservative starting point for a DB-backed scenario.
WRK2_RATE=2000
WRK2_LUA_SCRIPT=scenarios/entity-read-by-id/wrk2.lua
