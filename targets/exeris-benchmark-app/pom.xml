<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>eu.exeris.benchmarks</groupId>
  <artifactId>exeris-benchmark-app</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Exeris :: Benchmarks :: Target App Scaffold</name>
  <description>
    Extraction-ready benchmark target application scaffold.
    This module defines an edition-blind contract boundary and a first SPI+CORE bootstrap path.
  </description>

  <!-- JDK 26 is minimum for stable ScopedValue/ScopedValue.Carrier.
       Profiles provide forward compat for 21-25 with preview features enabled. -->
  <properties>
    <java.version>26</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.plugin.version>3.12.1</maven.compiler.plugin.version>
    <maven.compiler.enablePreview>true</maven.compiler.enablePreview>
    <exeris.kernel.version>0.5.0-SNAPSHOT</exeris.kernel.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>eu.exeris</groupId>
      <artifactId>exeris-kernel-spi</artifactId>
      <version>${exeris.kernel.version}</version>
    </dependency>
    <dependency>
      <groupId>eu.exeris</groupId>
      <artifactId>exeris-kernel-core</artifactId>
      <version>${exeris.kernel.version}</version>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>6.2.1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.5</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven.compiler.plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <enablePreview>${maven.compiler.enablePreview}</enablePreview>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>jdk21-backcompat</id>
      <activation>
        <jdk>[21,22)</jdk>
      </activation>
      <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.enablePreview>true</maven.compiler.enablePreview>
      </properties>
    </profile>
    <profile>
      <id>jdk22to25-enable-preview</id>
      <activation>
        <jdk>[22,26)</jdk>
      </activation>
      <properties>
        <maven.compiler.release>${java.specification.version}</maven.compiler.release>
        <maven.compiler.enablePreview>true</maven.compiler.enablePreview>
      </properties>
    </profile>
    <profile>
      <id>jdk26plus</id>
      <activation>
        <jdk>[26,)</jdk>
      </activation>
      <properties>
        <maven.compiler.release>${java.specification.version}</maven.compiler.release>
        <maven.compiler.enablePreview>true</maven.compiler.enablePreview>
      </properties>
    </profile>
  </profiles>
</project>