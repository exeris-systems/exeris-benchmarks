<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>eu.exeris.benchmarks</groupId>
  <artifactId>exeris-community-app</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Exeris :: Benchmarks :: Exeris Community App</name>
  <description>Standalone Exeris Community benchmark target app.</description>

  <properties>
    <java.version>26</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <maven.compiler.plugin.version>3.12.1</maven.compiler.plugin.version>
    <maven.shade.plugin.version>3.6.0</maven.shade.plugin.version>
    <graalvm.buildtools.native.version>0.10.3</graalvm.buildtools.native.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!--
      MUST match the kernel line the Spring arms carry, or kernel version becomes a free
      variable on exactly the comparison that closes HLA gap G1 (spring-hibernate vs
      exeris-community). The three Spring-on-Exeris arms are jar-verified on 0.10.2
      (community/core/spi); this arm was pinned one patch below at 0.10.1 and its jar dates
      from 2026-08-01, i.e. before the #50 kernel bump.

      Bump all four targets together and re-verify with:
        unzip -l <jar> | grep exeris-kernel      (Spring arms, fat jars)
        mvn -q dependency:list | grep exeris-kernel   (this arm, shaded)
    -->
    <exeris.kernel.version>0.10.2</exeris.kernel.version>
  </properties>

  <!--
    eu.exeris:* and eu.exeris.preview:* are published to GitHub Packages, not Central. Without this
    the build resolves only from Central and works purely by accident on a machine whose ~/.m2
    already holds the kernel from earlier work, then fails the moment a new version appears - which
    is exactly how preview 0.11.1 failed here. Credentials come from -s .github/maven-settings-gpr.xml
    (server ids must match the repository ids below).
  -->
  <repositories>
    <repository>
      <id>github-exeris-kernel</id>
      <url>https://maven.pkg.github.com/exeris-systems/exeris-kernel</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>${exeris.kernel.groupId}</groupId>
      <artifactId>exeris-kernel-spi</artifactId>
      <version>${exeris.kernel.version}</version>
    </dependency>
    <dependency>
      <groupId>${exeris.kernel.groupId}</groupId>
      <artifactId>exeris-kernel-core</artifactId>
      <version>${exeris.kernel.version}</version>
    </dependency>
    <!--
      Edition driver — RUNTIME scope only. The application compiles against exeris-kernel-spi +
      exeris-kernel-core (the base) and never imports eu.exeris.kernel.community.* / .enterprise.*.
      The concrete edition is selected on the runtime classpath via ServiceLoader
      (META-INF/services/eu.exeris.kernel.spi.*Provider), so swapping community <-> enterprise is a
      one-line change here with zero source changes.
    -->
    <dependency>
      <groupId>${exeris.kernel.groupId}</groupId>
      <artifactId>exeris-kernel-community</artifactId>
      <version>${exeris.kernel.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- JSON codec used directly by the app (route handler / JsonBodyEncoder). Previously supplied
         transitively by the edition jar; declared explicitly now that the edition is runtime-scoped,
         so the app compiles against SPI + CORE only. Version tracks exeris-kernel-bom (jackson 3.1.1). -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>3.1.1</version>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>6.2.1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.5</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.neo4j.driver</groupId>
      <artifactId>neo4j-java-driver</artifactId>
      <version>5.28.8</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
      <version>9.41.2</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven.compiler.plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <enablePreview>${exeris.compiler.enablePreview}</enablePreview>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <argLine>--enable-preview</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${maven.shade.plugin.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.EC</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>eu.exeris.benchmarks.targets.exeriscommunity.bootstrap.ExerisCommunityApplication</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <version>${graalvm.buildtools.native.version}</version>
            <configuration>
              <imageName>exeris-community-app</imageName>
              <mainClass>eu.exeris.benchmarks.targets.exeriscommunity.bootstrap.ExerisCommunityApplication</mainClass>
              <buildArgs>
                <buildArg>--enable-monitoring=jfr</buildArg>
                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                <buildArg>--initialize-at-build-time=eu.exeris.kernel.core.bootstrap</buildArg>
                <buildArg>--enable-preview</buildArg>
              </buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
