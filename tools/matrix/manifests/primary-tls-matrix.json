{
  "version": "1.0.0",
  "metadata": {
    "description": "Primary TLS benchmark matrix covering baseline JDK, Netty TCNative, Exeris Community, and Exeris Enterprise",
    "maintained_by": "benchmark-team",
    "last_updated": "2026-03-18"
  },
  "benchmarks": [
    {
      "id": "B3",
      "class": "SslEngineTlsBenchmark",
      "family": "baseline",
      "implementation_variant": "jdk-sslengine",
      "tier": "JDK",
      "scenario_classification": "tls-record-path-jdk-sslengine-inmemory-direct-only",
      "description": "Standard JDK SSLEngine TLS benchmark - baseline comparison",
      "requires_certs": false,
      "sysprops_env_source": "none",
      "common_jvm_args": [
        "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED",
        "--add-opens=java.base/java.io=ALL-UNNAMED",
        "--enable-native-access=ALL-UNNAMED",
        "-XX:+UseZGC",
        "-XX:+UnlockExperimentalVMOptions",
        "-Xms256m",
        "-Xmx256m"
      ],
      "phases": {
        "baseline": {
          "jmh_opts": ["-wi", "5", "-i", "10", "-w", "3s", "-r", "5s", "-f", "3"],
          "jvm_arg_overrides": [],
          "jfr_enabled": false,
          "gc_profiler_enabled": false,
          "expected_case_count": 8
        },
        "profile": {
          "jmh_opts": ["-wi", "5", "-i", "5", "-w", "2s", "-r", "5s", "-f", "1"],
          "jvm_arg_overrides": [],
          "jfr_enabled": true,
          "gc_profiler_enabled": false,
          "expected_case_count": 8
        },
        "gc": {
          "jmh_opts": ["-wi", "5", "-i", "5", "-w", "2s", "-r", "3s", "-f", "1"],
          "jvm_arg_overrides": ["-prof", "gc"],
          "jfr_enabled": false,
          "gc_profiler_enabled": true,
          "expected_case_count": 8
        }
      }
    },
